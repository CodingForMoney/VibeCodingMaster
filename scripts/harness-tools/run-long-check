#!/usr/bin/env node
"use strict";
// Start one VCM long-running validation job with a worker-enforced ceiling.
//
// Usage:
//   .ai/tools/run-long-check [--timeout <duration>] -- <command> [args...]
//
// Pass the validation executable and its arguments directly. Shell command-string
// wrappers are rejected because they can hide the validation command's exit code.
//
// The command runs in a detached worker process group. The worker itself
// enforces the job ceiling (--timeout, max 100m) and a supervision lease: when
// no foreground watcher renews .ai/vcm/jobs/<job-id>/lease, the worker kills
// the command process group and records the job as orphaned. Watch the job
// with .ai/tools/watch-job in the same turn.
//
// Only one validation job may be active at a time.

const childProcess = require("node:child_process");
const crypto = require("node:crypto");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const MAX_TIMEOUT_SECONDS = 100 * 60;
const DEFAULT_TIMEOUT_SECONDS = MAX_TIMEOUT_SECONDS;
const QUEUED_STALE_SECONDS = 60;
const ACTIVE_STATUSES = new Set(["queued", "starting", "running"]);
const DEFAULT_LEASE_START_GRACE_SECONDS = 300;
const DEFAULT_LEASE_RENEW_GRACE_SECONDS = 120;
const SHELL_EXECUTABLES = new Set(["sh", "bash", "zsh", "dash", "ksh", "fish", "csh", "tcsh"]);

function scriptPath() {
  return fs.realpathSync(__filename);
}

function rootDir() {
  return path.resolve(path.dirname(scriptPath()), "..", "..");
}

function jobsRoot() {
  return path.join(rootDir(), ".ai/vcm/jobs");
}

function nowIso() {
  return new Date().toISOString();
}

function sortKeys(value) {
  if (Array.isArray(value)) {
    return value.map(sortKeys);
  }
  if (value && typeof value === "object") {
    return Object.fromEntries(Object.keys(value).sort().map((key) => [key, sortKeys(value[key])]));
  }
  return value;
}

function jsonText(data) {
  return JSON.stringify(sortKeys(data), null, 2) + "\n";
}

function writeJson(target, data) {
  const temporary = target + ".tmp";
  fs.writeFileSync(temporary, jsonText(data));
  fs.renameSync(temporary, target);
}

function readOptionalJson(target) {
  try {
    return JSON.parse(fs.readFileSync(target, "utf8"));
  } catch {
    return null;
  }
}

function parseNumber(value) {
  if (!/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?$/i.test(value)) {
    throw new Error("invalid number: " + value);
  }
  return Number(value);
}

function parseDuration(value) {
  const normalized = value.trim().toLowerCase();
  if (normalized.endsWith("ms")) {
    return parseNumber(normalized.slice(0, -2)) / 1000;
  }
  if (normalized.endsWith("s")) {
    return parseNumber(normalized.slice(0, -1));
  }
  if (normalized.endsWith("m")) {
    return parseNumber(normalized.slice(0, -1)) * 60;
  }
  if (normalized.endsWith("h")) {
    return parseNumber(normalized.slice(0, -1)) * 3600;
  }
  return parseNumber(normalized);
}

function envSeconds(name, fallback) {
  const raw = process.env[name];
  if (!raw) {
    return fallback;
  }
  try {
    return Math.max(1, parseNumber(raw));
  } catch {
    return fallback;
  }
}

function newJobId() {
  const timestamp = new Date().toISOString().replace(/[-:]/g, "").replace(/\.\d+Z$/, "Z");
  return timestamp + "-" + crypto.randomUUID().replace(/-/g, "").slice(0, 8);
}

function shellCommandWrapper(command) {
  if (command.length === 0) {
    return null;
  }
  const candidates = path.basename(command[0]) === "env" ? command.map((_, index) => index) : [0];
  for (const index of candidates) {
    const executable = path.basename(command[index]);
    if (!SHELL_EXECUTABLES.has(executable)) {
      continue;
    }
    if (command.slice(index + 1).some((option) => option.startsWith("-") && !option.startsWith("--") && option.slice(1).includes("c"))) {
      return executable;
    }
  }
  return null;
}

function signalExists(target) {
  try {
    process.kill(target, 0);
    return true;
  } catch (error) {
    return error.code === "EPERM";
  }
}

function sleep(milliseconds) {
  return new Promise((resolve) => setTimeout(resolve, milliseconds));
}

async function waitForProcessGroupExit(child, timeoutSeconds) {
  const deadline = Date.now() + timeoutSeconds * 1000;
  while (Date.now() < deadline) {
    if (!signalExists(-child.pid)) {
      return true;
    }
    await sleep(50);
  }
  return !signalExists(-child.pid);
}

async function stopCommand(child) {
  let mode;
  try {
    process.kill(-child.pid, "SIGTERM");
    mode = "process-group";
  } catch (error) {
    if (error.code === "ESRCH") {
      return "not-running";
    }
    child.kill("SIGTERM");
    mode = "process";
  }

  if (await waitForProcessGroupExit(child, 2)) {
    return "terminated-" + mode;
  }

  try {
    process.kill(-child.pid, "SIGKILL");
  } catch {
    if (child.exitCode === null && child.signalCode === null) {
      child.kill("SIGKILL");
    }
  }
  return (await waitForProcessGroupExit(child, 2)) ? "killed-" + mode : "cleanup-incomplete-" + mode;
}

function leaseAgeSeconds(leasePath) {
  try {
    return Math.max(0, (Date.now() - fs.statSync(leasePath).mtimeMs) / 1000);
  } catch {
    return null;
  }
}

function leaseIso(leasePath) {
  try {
    return new Date(fs.statSync(leasePath).mtimeMs).toISOString();
  } catch {
    return null;
  }
}

function handoffDeadline(handoffPath) {
  const handoff = readOptionalJson(handoffPath);
  if (!handoff || typeof handoff.nextWatchDueAt !== "string") {
    return null;
  }
  const deadline = Date.parse(handoff.nextWatchDueAt);
  return Number.isNaN(deadline) ? null : { deadline, dueAt: handoff.nextWatchDueAt };
}

function clearHandoff(handoffPath) {
  fs.rmSync(handoffPath, { force: true });
}

function markStale(statusPath, status, reason) {
  writeJson(statusPath, { ...status, status: "stale", finishedAt: nowIso(), staleReason: reason });
}

function findActiveJob() {
  const root = jobsRoot();
  let entries;
  try {
    entries = fs.readdirSync(root, { withFileTypes: true });
  } catch {
    return null;
  }
  for (const entry of entries.sort((left, right) => left.name.localeCompare(right.name))) {
    if (!entry.isDirectory()) {
      continue;
    }
    const statusPath = path.join(root, entry.name, "status.json");
    const status = readOptionalJson(statusPath);
    if (!status || !ACTIVE_STATUSES.has(status.status)) {
      continue;
    }
    const pid = status.processId || status.workerPid;
    if (Number.isInteger(pid)) {
      if (signalExists(pid)) {
        return status;
      }
      markStale(statusPath, status, "job process not running");
      continue;
    }
    let age;
    try {
      age = (Date.now() - fs.statSync(statusPath).mtimeMs) / 1000;
    } catch {
      continue;
    }
    if (age < QUEUED_STALE_SECONDS) {
      return status;
    }
    markStale(statusPath, status, "queued job never started");
  }
  return null;
}

function isExecutableFile(candidate) {
  try {
    if (!fs.statSync(candidate).isFile()) {
      return false;
    }
    fs.accessSync(candidate, fs.constants.X_OK);
    return true;
  } catch {
    return false;
  }
}

function resolveExecutable(executable) {
  const root = rootDir();
  if (executable.includes("/")) {
    const candidate = path.resolve(root, executable);
    let stat;
    try {
      stat = fs.statSync(candidate);
    } catch {
      throw new Error("executable does not exist: " + candidate);
    }
    if (!stat.isFile()) {
      throw new Error("executable is not a regular file: " + candidate);
    }
    try {
      fs.accessSync(candidate, fs.constants.X_OK);
    } catch {
      throw new Error("file is not executable: " + candidate);
    }
    return candidate;
  }

  // The command runs in the worktree root, including for relative PATH entries.
  const entries = (process.env.PATH || "/bin:/usr/bin").split(path.delimiter);
  for (const entry of entries) {
    const candidate = path.join(path.resolve(root, entry), executable);
    if (isExecutableFile(candidate)) {
      return candidate;
    }
  }
  throw new Error("executable not found or not executable on PATH: " + executable);
}

// Python's subprocess fails with ENOEXEC for a file the kernel cannot execute,
// while libuv falls back to /bin/sh on some platforms. Check the header so an
// unrunnable validation file is always a launch failure.
function assertExecutableFormat(executable) {
  let header;
  try {
    const descriptor = fs.openSync(executable, "r");
    header = Buffer.alloc(4);
    fs.readSync(descriptor, header, 0, 4, 0);
    fs.closeSync(descriptor);
  } catch {
    return;
  }
  const magic = header.readUInt32BE(0);
  const known = header.subarray(0, 2).toString("latin1") === "#!"
    || header.toString("latin1") === "\x7fELF"
    || [0xfeedface, 0xfeedfacf, 0xcefaedfe, 0xcffaedfe, 0xcafebabe, 0xbebafeca].includes(magic)
    || header.subarray(0, 2).toString("latin1") === "MZ";
  if (!known) {
    const error = new Error("Exec format error: '" + executable + "'");
    error.code = "ENOEXEC";
    throw error;
  }
}

function launchErrorText(error) {
  return (error.code ? error.code + ": " : "") + error.message;
}

function recordLaunchFailure(directory, status, stage, error) {
  const message = "Unable to start " + stage + " for job " + status.jobId + ": "
    + "command='" + status.command[0] + "', cwd=" + rootDir() + ": " + launchErrorText(error);
  fs.appendFileSync(path.join(directory, "stderr.log"), message + "\n", "utf8");
  writeJson(path.join(directory, "status.json"), { ...status, status: "failed", finishedAt: nowIso(), exitCode: null });
  return message;
}

// Resolves with the spawned child once it starts, or rejects with its launch error.
function spawnStarted(command, args, options) {
  return new Promise((resolve, reject) => {
    let child;
    try {
      child = childProcess.spawn(command, args, options);
    } catch (error) {
      reject(error);
      return;
    }
    child.once("spawn", () => resolve(child));
    child.once("error", reject);
  });
}

async function startJob(commandArgs, timeoutSeconds) {
  let executable;
  try {
    executable = resolveExecutable(commandArgs[0]);
  } catch (error) {
    process.stderr.write("error: cannot start '" + commandArgs[0] + "' in " + rootDir() + ": " + error.message + "\n");
    return 2;
  }
  const command = [executable, ...commandArgs.slice(1)];

  const active = findActiveJob();
  if (active) {
    process.stderr.write("error: validation job " + active.jobId + " is already " + active.status + "\n");
    process.stderr.write("watch it: .ai/tools/watch-job " + active.jobId + "\n");
    process.stderr.write("VCM allows one validation job at a time.\n");
    return 3;
  }

  const job = newJobId();
  const directory = path.join(jobsRoot(), job);
  fs.mkdirSync(path.dirname(directory), { recursive: true });
  fs.mkdirSync(directory);

  fs.writeFileSync(path.join(directory, "command.json"), jsonText({
    command,
    cwd: ".",
    timeoutSeconds,
    createdAt: nowIso()
  }));
  const queued = {
    jobId: job,
    status: "queued",
    command,
    cwd: ".",
    timeoutSeconds,
    startedAt: null,
    finishedAt: null,
    exitCode: null,
    durationSeconds: null,
    workerPid: null,
    processId: null
  };
  writeJson(path.join(directory, "status.json"), queued);

  try {
    const worker = await spawnStarted(process.execPath, [scriptPath(), "--worker", job], {
      cwd: rootDir(),
      stdio: "ignore",
      detached: true
    });
    worker.unref();
  } catch (error) {
    const message = recordLaunchFailure(directory, queued, "job worker", error);
    process.stderr.write("error: " + message + "\n");
    return 1;
  }

  process.stdout.write("job: " + job + "\n");
  process.stdout.write("ceiling: " + Math.trunc(timeoutSeconds) + "s (worker-enforced)\n");
  process.stdout.write("watch: .ai/tools/watch-job " + job + "\n");
  return 0;
}

function exitCodeOf(code, signal) {
  if (code !== null && code !== undefined) {
    return code;
  }
  return signal ? -(os.constants.signals[signal] || 1) : null;
}

async function runWorker(job) {
  const directory = path.join(jobsRoot(), job);
  const statusPath = path.join(directory, "status.json");
  const leasePath = path.join(directory, "lease");
  const handoffPath = path.join(directory, "watch-handoff.json");

  const payload = JSON.parse(fs.readFileSync(path.join(directory, "command.json"), "utf8"));
  const command = payload.command;
  const timeoutSeconds = Math.min(Number(payload.timeoutSeconds) || DEFAULT_TIMEOUT_SECONDS, MAX_TIMEOUT_SECONDS);
  const startGrace = envSeconds("VCM_JOB_LEASE_START_GRACE_SECONDS", DEFAULT_LEASE_START_GRACE_SECONDS);
  const renewGrace = envSeconds("VCM_JOB_LEASE_RENEW_GRACE_SECONDS", DEFAULT_LEASE_RENEW_GRACE_SECONDS);

  const workerStarted = Date.now();
  const base = { jobId: job, command, cwd: ".", timeoutSeconds, workerPid: process.pid };
  const starting = {
    ...base,
    status: "starting",
    startedAt: null,
    finishedAt: null,
    exitCode: null,
    durationSeconds: null,
    processId: null
  };
  writeJson(statusPath, starting);

  const started = Date.now();
  const startedAt = nowIso();
  const stdout = fs.openSync(path.join(directory, "stdout.log"), "w");
  const stderr = fs.openSync(path.join(directory, "stderr.log"), "w");
  let child;
  try {
    assertExecutableFormat(command[0]);
    child = await spawnStarted(command[0], command.slice(1), {
      cwd: rootDir(),
      stdio: ["ignore", stdout, stderr],
      detached: true
    });
  } catch (error) {
    fs.closeSync(stdout);
    fs.closeSync(stderr);
    recordLaunchFailure(directory, starting, "validation command", error);
    return 1;
  }
  const exited = new Promise((resolve) => child.once("exit", (code, signal) => resolve(exitCodeOf(code, signal))));
  let hasExited = false;
  exited.then(() => {
    hasExited = true;
  });
  writeJson(statusPath, {
    ...base,
    status: "running",
    startedAt,
    finishedAt: null,
    exitCode: null,
    durationSeconds: null,
    processId: child.pid
  });

  let verdict = null;
  while (!hasExited) {
    if ((Date.now() - started) / 1000 >= timeoutSeconds) {
      verdict = { kind: "timeout", extra: { processStopResult: await stopCommand(child) } };
      break;
    }

    const leaseAge = leaseAgeSeconds(leasePath);
    if (leaseAge === null) {
      if ((Date.now() - workerStarted) / 1000 >= startGrace) {
        verdict = {
          kind: "orphaned",
          extra: {
            orphanReason: "no watcher within " + Math.trunc(startGrace) + "s",
            lastWatchedAt: null,
            processStopResult: await stopCommand(child)
          }
        };
        break;
      }
    } else if (leaseAge >= renewGrace) {
      const handoff = handoffDeadline(handoffPath);
      if (handoff === null || Date.now() >= handoff.deadline) {
        const extra = { lastWatchedAt: leaseIso(leasePath), processStopResult: await stopCommand(child) };
        if (handoff !== null) {
          extra.nextWatchDueAt = handoff.dueAt;
          extra.orphanReason = "next watcher did not resume before handoff deadline";
        } else {
          extra.orphanReason = "lease not renewed for " + Math.trunc(leaseAge) + "s";
        }
        verdict = { kind: "orphaned", extra };
        break;
      }
    }

    await Promise.race([sleep(1000), exited]);
  }
  const exitCode = await exited;
  fs.closeSync(stdout);
  fs.closeSync(stderr);

  const duration = Math.round(Date.now() - started) / 1000;
  clearHandoff(handoffPath);
  const current = readOptionalJson(statusPath) || {};
  if (["timeout", "orphaned", "stale"].includes(current.status)) {
    writeJson(statusPath, {
      ...current,
      processExitCode: exitCode,
      processFinishedAt: nowIso(),
      processDurationSeconds: duration
    });
    return 0;
  }

  const final = { ...base, startedAt, finishedAt: nowIso(), durationSeconds: duration, processId: child.pid };
  if (verdict === null) {
    Object.assign(final, { status: exitCode === 0 ? "success" : "failed", exitCode });
  } else {
    Object.assign(final, { status: verdict.kind, exitCode: null, processExitCode: exitCode, ...verdict.extra });
  }
  writeJson(statusPath, final);
  return 0;
}

async function main(argv) {
  if (argv.length >= 2 && argv[0] === "--worker") {
    return runWorker(argv[1]);
  }

  let timeoutSeconds = DEFAULT_TIMEOUT_SECONDS;
  let index = 0;
  while (index < argv.length && argv[index] !== "--") {
    const argument = argv[index];
    let raw;
    if (argument === "--timeout") {
      if (index + 1 >= argv.length) {
        process.stderr.write("error: --timeout needs a duration\n");
        return 2;
      }
      raw = argv[index + 1];
      index += 2;
    } else if (argument.startsWith("--timeout=")) {
      raw = argument.slice("--timeout=".length);
      index += 1;
    } else {
      process.stderr.write("error: unknown option: " + argument + "\n");
      return 2;
    }
    try {
      timeoutSeconds = parseDuration(raw);
    } catch {
      process.stderr.write("error: invalid duration: " + raw + "\n");
      return 2;
    }
  }

  if (index >= argv.length || argv[index] !== "--" || index + 1 >= argv.length) {
    process.stderr.write("Usage: .ai/tools/run-long-check [--timeout <duration>] -- <command> [args...]\n");
    return 2;
  }
  if (timeoutSeconds <= 0) {
    process.stderr.write("error: timeout must be positive\n");
    return 2;
  }
  if (timeoutSeconds > MAX_TIMEOUT_SECONDS) {
    process.stderr.write("error: timeout exceeds maximum 100m; split the work or get user approval\n");
    return 2;
  }

  const command = argv.slice(index + 1);
  const shellWrapper = shellCommandWrapper(command);
  if (shellWrapper) {
    process.stderr.write(
      "error: " + shellWrapper + " command-string wrappers are not allowed; "
      + "pass the validation executable and its arguments directly so its "
      + "exit code remains authoritative\n"
    );
    process.stderr.write(
      "run-long-check already captures stdout/stderr; do not add pipelines "
      + "or trailing commands to trim output\n"
    );
    return 2;
  }

  return startJob(command, timeoutSeconds);
}

if (require.main === module) {
  main(process.argv.slice(2)).then((code) => process.exit(code));
} else {
  module.exports = { startJob };
}
