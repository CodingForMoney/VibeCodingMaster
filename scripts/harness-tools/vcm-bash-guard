#!/usr/bin/env node
"use strict";
// VCM PreToolUse guard for supervised tools inside VCM workflow-role sessions.
//
// Reads the Claude Code PreToolUse hook payload on stdin. It enforces supervised
// Bash execution and managed-artifact writes for VCM workflow roles. Tool roles
// are outside the workflow and bypass this guard.
//
// Quoted payloads of `sh -c` / `bash -lc` style invocations are executable
// shell code, so they are scanned recursively. `.ai/tools/run-long-check` is the
// only sanctioned detached worker; the command it runs must still stay in the
// supervised foreground process group.

const fs = require("node:fs");

const WORKFLOW_ROLES = new Set(["project-manager", "architect", "coder", "tester", "reviewer"]);

const SKILL_HINT = "Use the vcm-long-running-validation skill instead: "
  + "`.ai/tools/run-long-check --timeout <duration> -- <command>` then "
  + "`.ai/tools/watch-job <job-id>` in the same turn, repeating watch-job "
  + "until it reports a terminal result.";
const ARTIFACT_HINT = "VCM-managed Markdown cannot be written directly. Write a candidate outside "
  + ".ai/vcm, then run .ai/tools/vcm-artifact <kind> --file <candidate> "
  + "--mode <draft|final>.";
const MAX_NESTED_SHELL_DEPTH = 3;
const QUOTED = /'([^']*)'|"([^"]*)"/g;
const SHELL_DASH_C = /(?:^|[\s;&|(])(?:sh|bash|zsh|dash|ksh)\s+(?:-\w+\s+)*-\w*c\w*(?:\s|$)/;
const PROTECTED_TOOL_INVOCATION = new RegExp(
  "(?:^|[;&|()\\n`])\\s*"
  + "(?:(?:[A-Za-z_][A-Za-z0-9_]*=[^\\s;&|()]+)\\s+)*"
  + "(?:[^\\s;&|()]*/)?(?:run-long-check|watch-job)(?=\\s|$)"
);
const HEREDOC_START = /<<(?!<)(-?)\s*(?:(['"])([^'"]+)\2|([^\s;&|()<>]+))/g;
const EXECUTABLE_HEREDOC_RECEIVER = new RegExp(
  "(?:^|[;&|()])\\s*"
  + "(?:(?:env\\s+)?(?:[A-Za-z_][A-Za-z0-9_]*=[^\\s;&|()]+\\s+)*)"
  + "(?:[^\\s;&|()]*/)?(?<receiver>sh|bash|zsh|dash|ksh|python\\d*(?:\\.\\d+)?|node)(?=\\s|$)"
);
const SHELL_HEREDOC_RECEIVERS = new Set(["sh", "bash", "zsh", "dash", "ksh"]);
const SHELL_CONTROL_OPERATOR = /(?:\|&?|&&|\|\||;|\n|\(|\)|`)/;
const RUN_LONG_CHECK_SHELL_STRING = new RegExp(
  "(?:^|[;&|()\\n])\\s*"
  + "(?:[^\\s;&|()]*/)?run-long-check\\b.*?\\s--\\s+"
  + "(?:env(?:\\s+[A-Za-z_][A-Za-z0-9_]*=[^\\s]+)*\\s+)?"
  + "(?:[^\\s;&|()]*/)?(?:sh|bash|zsh|dash|ksh)\\s+"
  + "(?:-\\w+\\s+)*-\\w*c\\w*(?:\\s|$)"
);
const COMMAND_SUBSTITUTION = /\$\(([^()]*)\)|`([^`]*)`/g;
const MANAGED_ARTIFACT_PATH = new RegExp(
  "(?:^|[\\s/\\\\])\\.ai[/\\\\]vcm[/\\\\](?:"
  + "handoffs[/\\\\].*\\.md|"
  + "gate-reviews[/\\\\]requests[/\\\\].*\\.report\\.md|"
  + "memory-review[/\\\\].*\\.md|"
  + "coder-workers[/\\\\]reports[/\\\\].*\\.md|"
  + "harness-feedback[/\\\\]pending[/\\\\].*\\.md"
  + ")"
);
const SHELL_SEPARATOR_TOKEN = /^[;&|()]+$/;
const SHELL_ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;
const PYTHON_PATH_MUTATION = /\bPath\s*\(\s*(['"])(?<path>[^'"]+)\1\s*\)\s*\.\s*(?:write_text|write_bytes|unlink|rmdir|touch|rename|replace)\s*\(/g;
const PYTHON_OPEN = /\bopen\s*\(\s*(['"])(?<path>[^'"]+)\1\s*,\s*(['"])(?<mode>[^'"]+)\3/g;
const NODE_PATH_MUTATION = new RegExp(
  "\\b(?:writeFile|writeFileSync|appendFile|appendFileSync|unlink|unlinkSync|"
  + "rm|rmSync|rmdir|rmdirSync|createWriteStream)\\s*\\(\\s*"
  + "(['\"])(?<path>[^'\"]+)\\1",
  "g"
);

function stripQuoted(command) {
  return command.replace(QUOTED, " ");
}

function quotedSegments(command) {
  return [...command.matchAll(QUOTED)].map((match) => match[1] ?? match[2] ?? "");
}

function doubleQuotedCommandSubstitutions(command) {
  const substitutions = [];
  for (const match of command.matchAll(QUOTED)) {
    const double = match[2];
    if (match[1] !== undefined || !double) {
      continue;
    }
    for (const substitution of double.matchAll(COMMAND_SUBSTITUTION)) {
      substitutions.push(substitution[1] ?? substitution[2] ?? "");
    }
  }
  return substitutions;
}

function stripEscapedCharacters(command) {
  let cleaned = "";
  let index = 0;
  while (index < command.length) {
    if (command[index] === "\\" && index + 1 < command.length) {
      cleaned += "  ";
      index += 2;
      continue;
    }
    cleaned += command[index];
    index += 1;
  }
  return cleaned;
}

function heredocReceiverLanguage(line) {
  const match = EXECUTABLE_HEREDOC_RECEIVER.exec(line);
  if (!match) {
    return null;
  }
  const receiver = match.groups.receiver;
  if (SHELL_HEREDOC_RECEIVERS.has(receiver)) {
    return "shell";
  }
  return receiver.startsWith("python") ? "python" : "node";
}

function splitLinesKeepEnds(text) {
  return text.match(/[^\r\n]*(?:\r\n|\r|\n)|[^\r\n]+$/g) ?? [];
}

function endsWithNewline(text) {
  return text.endsWith("\n") || text.endsWith("\r");
}

// Returns shell-only text, all executable text, and typed interpreter bodies.
function parseHeredocContent(command) {
  const pending = [];
  let shellExecutable = "";
  let allExecutable = "";
  const interpreterSections = [];
  for (const line of splitLinesKeepEnds(command)) {
    if (pending.length > 0) {
      const { delimiter, stripTabs, language, body } = pending[0];
      let candidate = line.replace(/[\r\n]+$/, "");
      if (stripTabs) {
        candidate = candidate.replace(/^\t+/, "");
      }
      if (candidate === delimiter) {
        pending.shift();
      } else if (language) {
        const contentLine = stripTabs ? line.replace(/^\t+/, "") : line;
        allExecutable += contentLine;
        if (language === "shell") {
          shellExecutable += contentLine;
        } else {
          body.push(contentLine);
          if (endsWithNewline(contentLine)) {
            shellExecutable += "\n";
          }
        }
      } else if (endsWithNewline(line)) {
        shellExecutable += "\n";
        allExecutable += "\n";
      }
      continue;
    }

    shellExecutable += line;
    allExecutable += line;
    const language = heredocReceiverLanguage(line);
    for (const match of line.matchAll(HEREDOC_START)) {
      const body = [];
      pending.push({ delimiter: match[3] ?? match[4], stripTabs: Boolean(match[1]), language, body });
      if (language === "python" || language === "node") {
        interpreterSections.push({ language, body });
      }
    }
  }
  return {
    shellCommand: shellExecutable,
    executable: allExecutable,
    interpreterSections: interpreterSections.map(({ language, body }) => ({ language, source: body.join("") }))
  };
}

// Removes data heredocs while preserving all executable interpreter bodies.
function stripHeredocBodies(command) {
  return parseHeredocContent(command).executable;
}

// Mirrors Python shlex in posix mode with punctuation_chars=";&|()<>" and
// whitespace_split: quotes are removed, runs of punctuation become tokens, and
// an unclosed quote or trailing escape makes the command unparsable.
function shellTokens(text) {
  const whitespace = " \t\r\n";
  const punctuation = ";&|()<>";
  const tokens = [];
  let current = "";
  let inWord = false;
  let index = 0;
  const finishWord = () => {
    if (inWord) {
      tokens.push(current);
      current = "";
      inWord = false;
    }
  };
  while (index < text.length) {
    const character = text[index];
    if (whitespace.includes(character)) {
      finishWord();
      index += 1;
      continue;
    }
    if (punctuation.includes(character)) {
      finishWord();
      let run = "";
      while (index < text.length && punctuation.includes(text[index])) {
        run += text[index];
        index += 1;
      }
      tokens.push(run);
      continue;
    }
    if (character === "\\") {
      if (index + 1 >= text.length) {
        throw new Error("No escaped character");
      }
      current += text[index + 1];
      inWord = true;
      index += 2;
      continue;
    }
    if (character === "'") {
      const end = text.indexOf("'", index + 1);
      if (end < 0) {
        throw new Error("No closing quotation");
      }
      current += text.slice(index + 1, end);
      inWord = true;
      index = end + 1;
      continue;
    }
    if (character === "\"") {
      index += 1;
      let closed = false;
      while (index < text.length) {
        const next = text[index];
        if (next === "\"") {
          closed = true;
          index += 1;
          break;
        }
        if (next === "\\" && index + 1 < text.length && (text[index + 1] === "\"" || text[index + 1] === "\\")) {
          current += text[index + 1];
          index += 2;
          continue;
        }
        current += next;
        index += 1;
      }
      if (!closed) {
        throw new Error("No closing quotation");
      }
      inWord = true;
      continue;
    }
    current += character;
    inWord = true;
    index += 1;
  }
  finishWord();
  return tokens;
}

function shellSegments(command) {
  const { shellCommand } = parseHeredocContent(command);
  const normalized = shellCommand.replaceAll("\\\n", " ").replaceAll("\n", " ; ");
  let tokens;
  try {
    tokens = shellTokens(normalized);
  } catch {
    return [];
  }

  const segments = [];
  let current = [];
  for (const token of tokens) {
    if (SHELL_SEPARATOR_TOKEN.test(token)) {
      if (current.length > 0) {
        segments.push(current);
        current = [];
      }
      continue;
    }
    current.push(token);
  }
  if (current.length > 0) {
    segments.push(current);
  }
  return segments;
}

function isManagedArtifactPath(value) {
  return MANAGED_ARTIFACT_PATH.test(value);
}

function baseName(token) {
  return token.split("/").pop();
}

function commandIndex(segment) {
  let index = 0;
  while (index < segment.length && SHELL_ASSIGNMENT.test(segment[index])) {
    index += 1;
  }
  if (index < segment.length && baseName(segment[index]) === "env") {
    index += 1;
    while (index < segment.length && (segment[index].startsWith("-") || SHELL_ASSIGNMENT.test(segment[index]))) {
      index += 1;
    }
  }
  return index < segment.length ? index : null;
}

function redirectionDetails(segment) {
  const targets = [];
  const consumed = new Set();
  segment.forEach((token, index) => {
    if (!token.includes(">") || ![...token].every((character) => "<>&|".includes(character))) {
      return;
    }
    consumed.add(index);
    if (index > 0 && /^\d+$/.test(segment[index - 1])) {
      consumed.add(index - 1);
    }
    if (index + 1 >= segment.length) {
      return;
    }
    consumed.add(index + 1);
    const target = segment[index + 1];
    if ((token === ">&" || token === "<&") && (/^\d+$/.test(target) || target === "-")) {
      return;
    }
    targets.push(target);
  });
  return { targets, consumed };
}

function commandOperands(segment, start, consumed) {
  const operands = [];
  let optionsDone = false;
  for (let index = start; index < segment.length; index += 1) {
    if (consumed.has(index)) {
      continue;
    }
    const token = segment[index];
    if (token === "--") {
      optionsDone = true;
      continue;
    }
    if (!optionsDone && token.startsWith("-")) {
      continue;
    }
    operands.push(token);
  }
  return operands;
}

function explicitInterpreterMutation(commandNames, source) {
  if ([...commandNames].some((name) => /^python\d*(?:\.\d+)?$/.test(name))) {
    for (const match of source.matchAll(PYTHON_PATH_MUTATION)) {
      if (isManagedArtifactPath(match.groups.path)) {
        return true;
      }
    }
    for (const match of source.matchAll(PYTHON_OPEN)) {
      if (isManagedArtifactPath(match.groups.path) && [..."wax+"].some((flag) => match.groups.mode.includes(flag))) {
        return true;
      }
    }
  }
  if (commandNames.has("node")) {
    return [...source.matchAll(NODE_PATH_MUTATION)].some((match) => isManagedArtifactPath(match.groups.path));
  }
  return false;
}

function mutatesManagedArtifact(command) {
  const executableCommand = stripHeredocBodies(command);
  const segments = shellSegments(command);
  const commandNames = new Set();
  for (const segment of segments) {
    const index = commandIndex(segment);
    if (index !== null) {
      commandNames.add(baseName(segment[index]));
    }
  }
  if (explicitInterpreterMutation(commandNames, executableCommand)) {
    return true;
  }

  for (const segment of segments) {
    const { targets, consumed } = redirectionDetails(segment);
    if (targets.some(isManagedArtifactPath)) {
      return true;
    }

    const executableIndex = commandIndex(segment);
    if (executableIndex === null) {
      continue;
    }
    const commandName = baseName(segment[executableIndex]);
    const argumentStart = executableIndex + 1;
    const args = segment.slice(argumentStart);
    const operands = commandOperands(segment, argumentStart, consumed);

    let targetDirectory = null;
    args.forEach((argument, index) => {
      if ((argument === "-t" || argument === "--target-directory") && index + 1 < args.length) {
        targetDirectory = args[index + 1];
      } else if (argument.startsWith("--target-directory=")) {
        targetDirectory = argument.split("=").slice(1).join("=");
      }
    });

    if (commandName === "cp") {
      const destination = targetDirectory || (operands.length >= 2 ? operands[operands.length - 1] : null);
      if (destination && isManagedArtifactPath(destination)) {
        return true;
      }
    } else if (commandName === "mv") {
      if (targetDirectory && isManagedArtifactPath(targetDirectory)) {
        return true;
      }
      if (operands.some(isManagedArtifactPath)) {
        return true;
      }
    } else if (commandName === "rm" || commandName === "tee") {
      if (operands.some(isManagedArtifactPath)) {
        return true;
      }
    } else if (commandName === "sed" || commandName === "perl") {
      const inPlace = args.some((argument) => argument.startsWith("-") && argument.slice(1).includes("i"));
      if (inPlace && args.some(isManagedArtifactPath)) {
        return true;
      }
    }
  }
  return false;
}

function unquotedAmpersand(commandWithoutQuotes) {
  const cleaned = commandWithoutQuotes
    .replace(/\d*>&\d*/g, " ")
    .replace(/<&\d*/g, " ")
    .replaceAll("&&", " ");
  return /&\s*(?:$|[;\n)])/.test(cleaned) || /\s&\s/.test(cleaned);
}

function protectedToolInvoked(commandWithoutQuotes) {
  return PROTECTED_TOOL_INVOCATION.test(commandWithoutQuotes);
}

function shellBackgroundReasons(command) {
  const stripped = stripEscapedCharacters(stripQuoted(command));
  const reasons = [];
  if (/(?:^|[\s;&|(])(?:nohup|setsid)(?:\s|$)/.test(stripped)) {
    reasons.push("nohup/setsid detach is forbidden");
  }
  if (/(?:^|[\s;&|(])disown(?:\s|$)/.test(stripped)) {
    reasons.push("disown is forbidden");
  }
  if (unquotedAmpersand(stripped)) {
    reasons.push("'&' background execution is forbidden");
  }
  return reasons;
}

// Masks Python comments (and optionally string contents) with spaces while
// preserving offsets, so call and import scanning only sees executable code.
function maskPython(source, maskStrings) {
  let output = "";
  let index = 0;
  while (index < source.length) {
    const character = source[index];
    if (character === "#") {
      while (index < source.length && source[index] !== "\n") {
        output += " ";
        index += 1;
      }
      continue;
    }
    if (character === "'" || character === "\"") {
      const triple = source.startsWith(character.repeat(3), index);
      const delimiter = triple ? character.repeat(3) : character;
      output += maskStrings ? " ".repeat(delimiter.length) : delimiter;
      index += delimiter.length;
      while (index < source.length) {
        if (source[index] === "\\" && index + 1 < source.length) {
          output += maskStrings ? "  " : source.slice(index, index + 2);
          index += 2;
          continue;
        }
        if (source.startsWith(delimiter, index)) {
          output += maskStrings ? " ".repeat(delimiter.length) : delimiter;
          index += delimiter.length;
          break;
        }
        if (!triple && source[index] === "\n") {
          break;
        }
        output += maskStrings && source[index] !== "\n" ? " " : source[index];
        index += 1;
      }
      continue;
    }
    output += character;
    index += 1;
  }
  return output;
}

function pythonImportAliases(code) {
  const aliases = new Map();
  for (const statement of code.split(/[;\n]/)) {
    const fromImport = /^\s*from\s+([A-Za-z_][\w.]*)\s+import\s+(.+)$/.exec(statement);
    if (fromImport) {
      for (const item of fromImport[2].replace(/[()]/g, " ").split(",")) {
        const parts = item.trim().split(/\s+as\s+/);
        if (parts[0]) {
          aliases.set((parts[1] || parts[0]).trim(), `${fromImport[1]}.${parts[0].trim()}`);
        }
      }
      continue;
    }
    const plainImport = /^\s*import\s+(.+)$/.exec(statement);
    if (plainImport) {
      for (const item of plainImport[1].split(",")) {
        const parts = item.trim().split(/\s+as\s+/);
        const name = parts[0].trim();
        if (name) {
          aliases.set(parts[1] ? parts[1].trim() : name.split(".")[0], name);
        }
      }
    }
  }
  return aliases;
}

// Returns the value of a plain Python string literal starting at offset when it
// is the whole argument, mirroring an ast.Constant first argument.
function pythonLiteralArgument(source, offset) {
  const match = /^\s*([rRuU]?)('''|"""|'|")/.exec(source.slice(offset));
  if (!match) {
    return null;
  }
  const delimiter = match[2];
  let index = offset + match[0].length;
  let value = "";
  while (index < source.length) {
    if (source[index] === "\\" && index + 1 < source.length) {
      value += source.slice(index, index + 2);
      index += 2;
      continue;
    }
    if (source.startsWith(delimiter, index)) {
      index += delimiter.length;
      return /^\s*[,)]/.test(source.slice(index)) ? value : null;
    }
    value += source[index];
    index += 1;
  }
  return null;
}

function callArgumentSpan(executable, openParen) {
  let depth = 0;
  for (let index = openParen; index < executable.length; index += 1) {
    if (executable[index] === "(") {
      depth += 1;
    } else if (executable[index] === ")") {
      depth -= 1;
      if (depth === 0) {
        return executable.slice(openParen + 1, index);
      }
    }
  }
  return executable.slice(openParen + 1);
}

function scanPythonBackgrounding(source) {
  const withoutComments = maskPython(source, false);
  const executable = maskPython(source, true);
  const aliases = pythonImportAliases(withoutComments);
  const reasons = [];
  const asynchronousCalls = new Set([
    "subprocess.Popen",
    "os.fork",
    "os.popen",
    "asyncio.create_subprocess_exec",
    "asyncio.create_subprocess_shell"
  ]);
  const shellCalls = new Set(["os.system", "subprocess.getoutput", "subprocess.getstatusoutput"]);
  const foregroundCalls = new Set(["subprocess.run", "subprocess.call", "subprocess.check_call", "subprocess.check_output"]);
  const callPattern = /(?<![\w.])([A-Za-z_]\w*(?:\s*\.\s*[A-Za-z_]\w*)*)\s*\(/g;
  for (const match of executable.matchAll(callPattern)) {
    if (/\b(?:def|class)\s+$/.test(executable.slice(0, match.index))) {
      continue;
    }
    const parts = match[1].replace(/\s+/g, "").split(".");
    const resolved = aliases.has(parts[0]) ? [...aliases.get(parts[0]).split("."), ...parts.slice(1)] : parts;
    const name = resolved.join(".");
    if (asynchronousCalls.has(name) || name.startsWith("os.spawn")) {
      reasons.push("Python asynchronous process creation is forbidden");
      continue;
    }
    const openParen = match.index + match[0].length - 1;
    const command = pythonLiteralArgument(source, openParen + 1);
    if (shellCalls.has(name) && command && shellBackgroundReasons(command).length > 0) {
      reasons.push("Python shell background execution is forbidden");
      continue;
    }
    if (foregroundCalls.has(name)) {
      const usesShell = /(?:^|[,\s])shell\s*=\s*True\b/.test(callArgumentSpan(executable, openParen));
      if (usesShell && command && shellBackgroundReasons(command).length > 0) {
        reasons.push("Python shell background execution is forbidden");
      }
    }
  }
  return reasons;
}

function maskJavascript(source, maskStrings) {
  let output = "";
  let state = "code";
  let quote = "";
  let index = 0;
  while (index < source.length) {
    const character = source[index];
    const following = index + 1 < source.length ? source[index + 1] : "";
    if (state === "code") {
      if (character === "/" && following === "/") {
        output += "  ";
        state = "line-comment";
        index += 2;
        continue;
      }
      if (character === "/" && following === "*") {
        output += "  ";
        state = "block-comment";
        index += 2;
        continue;
      }
      if (character === "'" || character === "\"" || character === "`") {
        quote = character;
        state = "string";
        output += maskStrings ? " " : character;
        index += 1;
        continue;
      }
      output += character;
      index += 1;
      continue;
    }
    if (state === "line-comment") {
      output += character === "\n" ? "\n" : " ";
      if (character === "\n") {
        state = "code";
      }
      index += 1;
      continue;
    }
    if (state === "block-comment") {
      if (character === "*" && following === "/") {
        output += "  ";
        state = "code";
        index += 2;
      } else {
        output += character === "\n" ? "\n" : " ";
        index += 1;
      }
      continue;
    }
    if (character === "\\" && following) {
      output += maskStrings ? "  " : character + following;
      index += 2;
      continue;
    }
    output += maskStrings && character !== "\n" ? " " : character;
    if (character === quote) {
      state = "code";
    }
    index += 1;
  }
  return output;
}

function escapeRegExp(value) {
  return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function scanNodeBackgrounding(source) {
  const withoutComments = maskJavascript(source, false);
  const executable = maskJavascript(source, true);
  const moduleAliases = new Set(["child_process"]);
  const functionAliases = new Set();
  const modulePattern = "(?:node:)?child_process";
  for (const match of withoutComments.matchAll(new RegExp(
    `\\b(?:const|let|var)\\s+([A-Za-z_$][\\w$]*)\\s*=\\s*require\\(\\s*['"]${modulePattern}['"]\\s*\\)`,
    "g"
  ))) {
    moduleAliases.add(match[1]);
  }
  for (const match of withoutComments.matchAll(new RegExp(
    `\\bimport\\s+\\*\\s+as\\s+([A-Za-z_$][\\w$]*)\\s+from\\s+['"]${modulePattern}['"]`,
    "g"
  ))) {
    moduleAliases.add(match[1]);
  }
  const destructuredPatterns = [
    `\\b(?:const|let|var)\\s*\\{([^}]+)\\}\\s*=\\s*require\\(\\s*['"]${modulePattern}['"]\\s*\\)`,
    `\\bimport\\s*\\{([^}]+)\\}\\s*from\\s*['"]${modulePattern}['"]`
  ];
  const asynchronous = new Set(["spawn", "exec", "execFile", "fork"]);
  for (const pattern of destructuredPatterns) {
    for (const match of withoutComments.matchAll(new RegExp(pattern, "g"))) {
      for (const item of match[1].split(",")) {
        const parts = item.trim().split(/\s+(?:as)\s+|\s*:\s*/);
        if (parts.length > 0 && asynchronous.has(parts[0])) {
          functionAliases.add(parts[parts.length - 1]);
        }
      }
    }
  }
  for (const alias of moduleAliases) {
    if (new RegExp(`\\b${escapeRegExp(alias)}\\s*\\.\\s*(?:spawn|exec|execFile|fork)\\s*\\(`).test(executable)) {
      return ["Node asynchronous process creation is forbidden"];
    }
  }
  for (const alias of functionAliases) {
    if (new RegExp(`\\b${escapeRegExp(alias)}\\s*\\(`).test(executable)) {
      return ["Node asynchronous process creation is forbidden"];
    }
  }
  if (new RegExp(`\\brequire\\(\\s*['"]${modulePattern}['"]\\s*\\)\\s*\\.\\s*(?:spawn|exec|execFile|fork)\\s*\\(`).test(withoutComments)) {
    return ["Node asynchronous process creation is forbidden"];
  }
  return [];
}

function scanShellCommand(command, depth = 0) {
  const { shellCommand, interpreterSections } = parseHeredocContent(command);
  const reasons = shellBackgroundReasons(shellCommand);
  const stripped = stripEscapedCharacters(stripQuoted(shellCommand));
  if (protectedToolInvoked(stripped)) {
    if (SHELL_CONTROL_OPERATOR.test(stripped)) {
      reasons.push("run-long-check and watch-job must be standalone Bash commands");
    }
    if (RUN_LONG_CHECK_SHELL_STRING.test(stripped)) {
      reasons.push("run-long-check must receive a direct executable or script, not a shell command string");
    }
  }

  // `sh -c '...'` quoted payloads are shell code, not plain strings.
  if (depth < MAX_NESTED_SHELL_DEPTH && SHELL_DASH_C.test(stripped)) {
    for (const segment of quotedSegments(shellCommand)) {
      if (protectedToolInvoked(stripEscapedCharacters(stripQuoted(segment)))) {
        reasons.push("run-long-check and watch-job must not be invoked through a shell command string");
      }
      reasons.push(...scanShellCommand(segment, depth + 1));
    }
  }
  if (depth < MAX_NESTED_SHELL_DEPTH) {
    for (const substitution of doubleQuotedCommandSubstitutions(shellCommand)) {
      if (protectedToolInvoked(stripEscapedCharacters(stripQuoted(substitution)))) {
        reasons.push("run-long-check and watch-job must not be invoked through command substitution");
      }
      reasons.push(...scanShellCommand(substitution, depth + 1));
    }
  }
  for (const { language, source } of interpreterSections) {
    if (language === "python") {
      reasons.push(...scanPythonBackgrounding(source));
    } else if (language === "node") {
      reasons.push(...scanNodeBackgrounding(source));
    }
  }
  return reasons;
}

function guardReasons(toolInput) {
  const reasons = [];
  if (toolInput.run_in_background) {
    reasons.push("Bash run_in_background is forbidden");
  }
  const command = typeof toolInput.command === "string" ? toolInput.command : "";
  reasons.push(...scanShellCommand(command));
  if (mutatesManagedArtifact(command)) {
    reasons.push("direct Bash writes to VCM-managed Markdown are forbidden");
  }
  return [...new Set(reasons)];
}

function asObject(value) {
  return value && typeof value === "object" && !Array.isArray(value) ? value : {};
}

function main() {
  const raw = fs.readFileSync(0, "utf8");
  if (!WORKFLOW_ROLES.has((process.env.VCM_ROLE || "").trim())) {
    return;
  }

  let payload;
  try {
    payload = raw.trim() ? JSON.parse(raw) : {};
  } catch {
    return;
  }
  payload = asObject(payload);
  let reasons;
  if (payload.tool_name === "Bash") {
    reasons = guardReasons(asObject(payload.tool_input));
  } else if (payload.tool_name === "Write" || payload.tool_name === "Edit") {
    const toolInput = asObject(payload.tool_input);
    const filePath = toolInput.file_path || toolInput.path;
    reasons = typeof filePath === "string" && MANAGED_ARTIFACT_PATH.test(filePath)
      ? ["direct Write/Edit of VCM-managed Markdown is forbidden"]
      : [];
  } else {
    return;
  }
  if (reasons.length === 0) {
    return;
  }

  process.stdout.write(`${JSON.stringify({
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: `VCM denied this tool call (${reasons.join("; ")}). `
        + (reasons.some((reason) => reason.includes("Markdown")) ? ARTIFACT_HINT : SKILL_HINT)
    }
  })}\n`);
}

main();
