#!/usr/bin/env node
"use strict";
// Submit a VCM-managed Markdown artifact through the VCM backend.

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

function fail(message) {
  process.stderr.write("VCM artifact submission failed: " + message + "\n");
  process.exit(1);
}

function usageError(message) {
  process.stderr.write(
    "usage: vcm-artifact [-h] --file FILE [--mode {draft,final}] [--path PATH] [--keep-candidate] kind\n"
    + "vcm-artifact: error: " + message + "\n"
  );
  process.exit(2);
}

function parseArgs(argv) {
  const args = { kind: undefined, file: undefined, mode: "final", path: undefined, keepCandidate: false };
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "-h" || argument === "--help") {
      process.stdout.write(
        "usage: vcm-artifact [-h] --file FILE [--mode {draft,final}] [--path PATH] [--keep-candidate] kind\n\n"
        + "Validate and atomically write a VCM-managed artifact.\n\n"
        + "  kind              VCM-managed artifact kind.\n"
        + "  --file FILE       Candidate Markdown file.\n"
        + "  --mode {draft,final}\n"
        + "  --path PATH       Repository-relative VCM-assigned destination; never an absolute path. VCM selects the artifact's repository root.\n"
        + "  --keep-candidate  Keep the candidate after a successful submission.\n"
      );
      process.exit(0);
    }
    if (argument === "--keep-candidate") {
      args.keepCandidate = true;
      continue;
    }
    const separator = argument.indexOf("=");
    const name = argument.startsWith("--") && separator >= 0 ? argument.slice(0, separator) : argument;
    if (name === "--file" || name === "--mode" || name === "--path") {
      let value;
      if (separator >= 0 && argument.startsWith("--")) {
        value = argument.slice(separator + 1);
      } else {
        if (index + 1 >= argv.length) {
          usageError("argument " + name + ": expected one argument");
        }
        index += 1;
        value = argv[index];
      }
      if (name === "--mode" && value !== "draft" && value !== "final") {
        usageError("argument --mode: invalid choice: '" + value + "' (choose from 'draft', 'final')");
      }
      args[name.slice(2)] = value;
      continue;
    }
    if (argument.startsWith("--")) {
      usageError("unrecognized arguments: " + argument);
    }
    if (args.kind !== undefined) {
      usageError("unrecognized arguments: " + argument);
    }
    args.kind = argument;
  }
  const missing = [];
  if (args.kind === undefined) {
    missing.push("kind");
  }
  if (args.file === undefined) {
    missing.push("--file");
  }
  if (missing.length > 0) {
    usageError("the following arguments are required: " + missing.join(", "));
  }
  return args;
}

function requiredEnv(name) {
  const value = (process.env[name] || "").trim();
  if (!value) {
    fail(name + " is required. Run this tool from an active VCM role Session.");
  }
  return value;
}

function errorText(raw) {
  let payload;
  try {
    payload = JSON.parse(raw);
  } catch {
    return raw.trim() || "VCM backend returned an empty error.";
  }
  if (payload && typeof payload === "object" && !Array.isArray(payload)) {
    let message = payload.message;
    let hint = payload.hint;
    if (payload.error && typeof payload.error === "object") {
      message = payload.error.message ?? message;
      hint = payload.error.hint ?? hint;
    }
    const parts = [message, hint].filter(Boolean).map((value) => String(value).trim());
    if (parts.length > 0) {
      return parts.join("\n");
    }
  }
  return raw.trim() || "VCM backend rejected the artifact.";
}

function expandUser(file) {
  return file === "~" || file.startsWith("~/") ? path.join(os.homedir(), file.slice(1)) : file;
}

async function main() {
  const args = parseArgs(process.argv.slice(2));

  const candidate = expandUser(args.file);
  let stat;
  try {
    stat = fs.statSync(candidate);
  } catch {
    stat = undefined;
  }
  if (!stat || !stat.isFile()) {
    fail("candidate does not exist: " + candidate);
  }
  const content = fs.readFileSync(candidate, "utf8");
  if (!content.trim()) {
    fail("candidate is empty.");
  }

  const apiUrl = requiredEnv("VCM_API_URL").replace(/\/+$/, "");
  const taskSlug = requiredEnv("VCM_TASK_SLUG");
  const payload = {
    kind: args.kind,
    mode: args.mode,
    role: requiredEnv("VCM_ROLE"),
    runtimeSessionToken: requiredEnv("VCM_RUNTIME_SESSION_TOKEN"),
    content
  };
  if (args.path) {
    payload.path = args.path;
  }

  let response;
  try {
    response = await fetch(apiUrl + "/api/tasks/" + encodeURIComponent(taskSlug) + "/artifacts/submit", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload),
      signal: AbortSignal.timeout(30000)
    });
  } catch (error) {
    const cause = error && error.cause;
    fail("VCM backend could not be reached at " + apiUrl + ": " + ((cause && (cause.message || cause.code)) || error.message));
  }
  const raw = await response.text();
  if (!response.ok) {
    fail(errorText(raw));
  }

  let result;
  try {
    result = JSON.parse(raw);
  } catch {
    fail("VCM backend returned invalid JSON.");
  }
  if (!result || typeof result !== "object" || result.ok !== true) {
    fail(errorText(raw));
  }

  if (!args.keepCandidate) {
    fs.rmSync(candidate, { force: true });
  }
  process.stdout.write(
    "VCM artifact accepted: " + result.kind + " -> " + result.path + " (" + result.mode + ", " + result.status + ")\n"
  );
}

main();
