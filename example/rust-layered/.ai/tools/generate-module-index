#!/usr/bin/env node
"use strict";
// Generate .ai/generated/module-index.json from Cargo or npm workspace metadata.

const childProcess = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

const NODE_SOURCE_EXTENSIONS = [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"];
const NODE_EXCLUDED_DIRS = new Set(["node_modules", "dist", "build", "coverage", ".next", ".turbo", ".vite"]);
const NODE_DEPENDENCY_TABLES = ["dependencies", "devDependencies", "peerDependencies", "optionalDependencies"];
const NODE_TEST_MARKERS = [".test.", ".spec."];
const RUST_EXCLUDED_DIRS = new Set(["target", ".git"]);
const USAGE = "usage: generate-module-index [-h] [--check] [--print] [--output OUTPUT]";

class ToolExit extends Error {}

function fail(message) {
  throw new ToolExit(message);
}

function isObject(value) {
  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
}

// Python truthiness, so empty lists and objects count as false.
function truthy(value) {
  if (Array.isArray(value)) {
    return value.length > 0;
  }
  if (isObject(value)) {
    return Object.keys(value).length > 0;
  }
  return Boolean(value);
}

function compareStrings(left, right) {
  return left < right ? -1 : left > right ? 1 : 0;
}

function sortedStrings(values) {
  return [...values].sort(compareStrings);
}

function isFile(target) {
  try {
    return fs.statSync(target).isFile();
  } catch {
    return false;
  }
}

function isDir(target) {
  try {
    return fs.statSync(target).isDirectory();
  } catch {
    return false;
  }
}

function resolvePath(target) {
  try {
    return fs.realpathSync(target);
  } catch {
    const parent = path.dirname(target);
    return parent === target ? target : path.join(resolvePath(parent), path.basename(target));
  }
}

function toPosix(relative) {
  return relative.split(path.sep).join("/");
}

function isInside(relative) {
  return relative !== ".." && !relative.startsWith(".." + path.sep) && !path.isAbsolute(relative);
}

function relativePath(target, root) {
  let relative = path.relative(path.resolve(root), path.resolve(target));
  if (!isInside(relative)) {
    relative = path.relative(resolvePath(root), resolvePath(target));
    if (!isInside(relative)) {
      fail("'" + target + "' is not in the subpath of '" + root + "'");
    }
  }
  return relative === "" ? "." : toPosix(relative);
}

function pathSuffix(target) {
  const name = path.basename(target);
  const index = name.lastIndexOf(".");
  return index > 0 && index < name.length - 1 ? name.slice(index) : "";
}

function listDir(directory) {
  try {
    return fs.readdirSync(directory, { withFileTypes: true });
  } catch {
    return [];
  }
}

function fnmatchSource(pattern) {
  let source = "";
  for (let index = 0; index < pattern.length; index += 1) {
    const character = pattern[index];
    if (character === "*") {
      source += "[\\s\\S]*";
    } else if (character === "?") {
      source += "[\\s\\S]";
    } else if (character === "[") {
      let end = index + 1;
      if (pattern[end] === "!") {
        end += 1;
      }
      if (pattern[end] === "]") {
        end += 1;
      }
      while (end < pattern.length && pattern[end] !== "]") {
        end += 1;
      }
      if (end >= pattern.length) {
        source += "\\[";
      } else {
        let body = pattern.slice(index + 1, end).replace(/\\/g, "\\\\");
        if (body.startsWith("!")) {
          body = "^" + body.slice(1);
        } else if (body.startsWith("^")) {
          body = "\\" + body;
        }
        source += "[" + body + "]";
        index = end;
      }
    } else {
      source += character.replace(/[.*+?^${}()|[\]\\/-]/g, "\\$&");
    }
  }
  return source;
}

function fnmatch(name, pattern) {
  return new RegExp("^(?:" + fnmatchSource(pattern) + ")$").test(name);
}

function hasWildcard(part) {
  return /[*?[]/.test(part);
}

// Mirrors pathlib.Path.glob: "**" matches this directory and every
// non-symlink subdirectory; other parts match one path component.
function globPaths(base, pattern) {
  const parts = pattern.split("/").filter((part) => part !== "" && part !== ".");
  let current = [base];
  parts.forEach((part, partIndex) => {
    const last = partIndex === parts.length - 1;
    const next = [];
    const seen = new Set();
    const add = (candidate) => {
      if (!seen.has(candidate)) {
        seen.add(candidate);
        next.push(candidate);
      }
    };
    for (const directory of current) {
      if (part === "**") {
        const walk = (dir) => {
          add(dir);
          for (const entry of listDir(dir)) {
            if (entry.isDirectory()) {
              walk(path.join(dir, entry.name));
            }
          }
        };
        if (isDir(directory)) {
          walk(directory);
        }
      } else if (hasWildcard(part)) {
        for (const entry of listDir(directory)) {
          const candidate = path.join(directory, entry.name);
          if (fnmatch(entry.name, part) && (last || isDir(candidate))) {
            add(candidate);
          }
        }
      } else {
        const candidate = path.join(directory, part);
        if (last ? fs.existsSync(candidate) : isDir(candidate)) {
          add(candidate);
        }
      }
    }
    current = next;
  });
  return current;
}

// Recursive listing that, like Path.rglob, does not descend into symlinked directories.
function walkFiles(directory) {
  const results = [];
  const walk = (dir) => {
    for (const entry of listDir(dir)) {
      const candidate = path.join(dir, entry.name);
      results.push(candidate);
      if (entry.isDirectory()) {
        walk(candidate);
      }
    }
  };
  walk(directory);
  return results;
}

function comparePathParts(left, right) {
  const leftParts = left.split(path.sep);
  const rightParts = right.split(path.sep);
  for (let index = 0; index < Math.min(leftParts.length, rightParts.length); index += 1) {
    const order = compareStrings(leftParts[index], rightParts[index]);
    if (order !== 0) {
      return order;
    }
  }
  return leftParts.length - rightParts.length;
}

// Minimal TOML reader covering the syntax Cargo manifests use.
function parseToml(text) {
  const root = {};
  let current = root;
  let index = 0;

  const error = (message) => fail("Invalid TOML: " + message + " (offset " + index + ")");
  const peek = (offset = 0) => text[index + offset];
  const startsWith = (value) => text.startsWith(value, index);

  function skipInlineSpace() {
    while (peek() === " " || peek() === "\t") {
      index += 1;
    }
  }

  function skipComment() {
    if (peek() === "#") {
      while (index < text.length && peek() !== "\n") {
        index += 1;
      }
    }
  }

  function skipBlank() {
    while (index < text.length) {
      skipInlineSpace();
      skipComment();
      if (peek() === "\n" || peek() === "\r") {
        index += 1;
      } else {
        return;
      }
    }
  }

  function parseEscape() {
    const character = peek();
    index += 1;
    const simple = { b: "\b", t: "\t", n: "\n", f: "\f", r: "\r", "\"": "\"", "\\": "\\", e: "\x1b" };
    if (character in simple) {
      return simple[character];
    }
    if (character === "u" || character === "U") {
      const length = character === "u" ? 4 : 8;
      const hex = text.slice(index, index + length);
      if (!/^[0-9A-Fa-f]+$/.test(hex) || hex.length !== length) {
        error("invalid unicode escape");
      }
      index += length;
      return String.fromCodePoint(parseInt(hex, 16));
    }
    if (character === "x") {
      const hex = text.slice(index, index + 2);
      index += 2;
      return String.fromCharCode(parseInt(hex, 16));
    }
    return error("invalid escape");
  }

  function parseBasicString() {
    if (startsWith("\"\"\"")) {
      index += 3;
      if (peek() === "\r" && peek(1) === "\n") {
        index += 2;
      } else if (peek() === "\n") {
        index += 1;
      }
      let value = "";
      while (index < text.length) {
        if (startsWith("\"\"\"")) {
          let quotes = 3;
          while (quotes < 5 && text[index + quotes] === "\"") {
            quotes += 1;
          }
          value += "\"".repeat(quotes - 3);
          index += quotes;
          return value;
        }
        if (peek() === "\\") {
          index += 1;
          if (/^[ \t]*\r?\n/.test(text.slice(index))) {
            while (/[ \t\r\n]/.test(peek() || "")) {
              index += 1;
            }
            continue;
          }
          value += parseEscape();
          continue;
        }
        value += peek();
        index += 1;
      }
      return error("unterminated string");
    }
    index += 1;
    let value = "";
    while (index < text.length && peek() !== "\"") {
      if (peek() === "\n") {
        error("newline in string");
      }
      if (peek() === "\\") {
        index += 1;
        value += parseEscape();
        continue;
      }
      value += peek();
      index += 1;
    }
    if (peek() !== "\"") {
      error("unterminated string");
    }
    index += 1;
    return value;
  }

  function parseLiteralString() {
    if (startsWith("'''")) {
      index += 3;
      if (peek() === "\r" && peek(1) === "\n") {
        index += 2;
      } else if (peek() === "\n") {
        index += 1;
      }
      let end = text.indexOf("'''", index);
      if (end < 0) {
        error("unterminated string");
      }
      while (text[end + 3] === "'") {
        end += 1;
      }
      const value = text.slice(index, end);
      index = end + 3;
      return value;
    }
    index += 1;
    const end = text.indexOf("'", index);
    if (end < 0 || text.slice(index, end).includes("\n")) {
      error("unterminated string");
    }
    const value = text.slice(index, end);
    index = end + 1;
    return value;
  }

  function parseKeyPart() {
    if (peek() === "\"") {
      return parseBasicString();
    }
    if (peek() === "'") {
      return parseLiteralString();
    }
    const match = /^[A-Za-z0-9_-]+/.exec(text.slice(index));
    if (!match) {
      error("invalid key");
    }
    index += match[0].length;
    return match[0];
  }

  function parseKey() {
    const parts = [];
    while (true) {
      skipInlineSpace();
      parts.push(parseKeyPart());
      skipInlineSpace();
      if (peek() !== ".") {
        return parts;
      }
      index += 1;
    }
  }

  function parseArray() {
    index += 1;
    const values = [];
    while (true) {
      skipBlank();
      if (peek() === "]") {
        index += 1;
        return values;
      }
      values.push(parseValue());
      skipBlank();
      if (peek() === ",") {
        index += 1;
      } else if (peek() !== "]") {
        error("expected , or ]");
      }
    }
  }

  function parseInlineTable() {
    index += 1;
    const table = {};
    skipInlineSpace();
    if (peek() === "}") {
      index += 1;
      return table;
    }
    while (true) {
      const key = parseKey();
      if (peek() !== "=") {
        error("expected =");
      }
      index += 1;
      skipInlineSpace();
      assign(table, key, parseValue());
      skipInlineSpace();
      if (peek() === ",") {
        index += 1;
        continue;
      }
      if (peek() === "}") {
        index += 1;
        return table;
      }
      error("expected , or }");
    }
  }

  function parseValue() {
    const character = peek();
    if (character === "\"") {
      return parseBasicString();
    }
    if (character === "'") {
      return parseLiteralString();
    }
    if (character === "[") {
      return parseArray();
    }
    if (character === "{") {
      return parseInlineTable();
    }
    const match = /^[^\s,\]}#]+(?: [0-9][^\s,\]}#]*)?/.exec(text.slice(index));
    if (!match) {
      error("invalid value");
    }
    index += match[0].length;
    const raw = match[0];
    if (raw === "true") {
      return true;
    }
    if (raw === "false") {
      return false;
    }
    if (/^[+-]?(?:inf|nan)$/.test(raw)) {
      return raw.includes("nan") ? NaN : raw.startsWith("-") ? -Infinity : Infinity;
    }
    const cleaned = raw.replace(/_/g, "");
    if (/^[+-]?(?:0x[0-9a-fA-F]+|0o[0-7]+|0b[01]+)$/.test(cleaned)) {
      const sign = cleaned.startsWith("-") ? -1 : 1;
      return sign * Number(cleaned.replace(/^[+-]/, ""));
    }
    if (/^[+-]?(?:\d+)(?:\.\d+)?(?:[eE][+-]?\d+)?$/.test(cleaned)) {
      return Number(cleaned);
    }
    // Dates and times are kept as their source text.
    return raw;
  }

  function descend(table, key, forArrayTable) {
    let target = table;
    key.forEach((part, partIndex) => {
      const last = partIndex === key.length - 1;
      if (last && forArrayTable) {
        if (!(part in target)) {
          target[part] = [];
        }
        if (!Array.isArray(target[part])) {
          error("key redefined as array of tables");
        }
        const entry = {};
        target[part].push(entry);
        target = entry;
        return;
      }
      if (!(part in target)) {
        target[part] = {};
      }
      let next = target[part];
      if (Array.isArray(next)) {
        next = next[next.length - 1];
      }
      if (!isObject(next)) {
        error("key redefined as table");
      }
      target = next;
    });
    return target;
  }

  function assign(table, key, value) {
    const parent = descend(table, key.slice(0, -1), false);
    const last = key[key.length - 1];
    if (last in parent) {
      error("duplicate key " + key.join("."));
    }
    parent[last] = value;
  }

  while (true) {
    skipBlank();
    if (index >= text.length) {
      return root;
    }
    if (startsWith("[[")) {
      index += 2;
      const key = parseKey();
      if (!startsWith("]]")) {
        error("expected ]]");
      }
      index += 2;
      current = descend(root, key, true);
    } else if (peek() === "[") {
      index += 1;
      const key = parseKey();
      if (peek() !== "]") {
        error("expected ]");
      }
      index += 1;
      current = descend(root, key, false);
    } else {
      const key = parseKey();
      if (peek() !== "=") {
        error("expected =");
      }
      index += 1;
      skipInlineSpace();
      assign(current, key, parseValue());
    }
    skipInlineSpace();
    skipComment();
    if (index < text.length && peek() !== "\n" && peek() !== "\r") {
      error("expected end of line");
    }
  }
}

function maybeFindRoot(projectRoot, manifestName) {
  if (isFile(path.join(projectRoot, manifestName))) {
    return projectRoot;
  }
  for (const name of sortedStrings(fs.readdirSync(projectRoot))) {
    const child = path.join(projectRoot, name);
    if (isDir(child) && isFile(path.join(child, manifestName))) {
      return child;
    }
  }
  return null;
}

function loadJson(target) {
  return JSON.parse(fs.readFileSync(target, "utf8").replace(/\r\n?/g, "\n"));
}

function loadToml(target) {
  return parseToml(fs.readFileSync(target, "utf8").replace(/\r\n?/g, "\n"));
}

function getTable(data, key) {
  return isObject(data) && key in data ? data[key] : {};
}

function loadCargoMetadata(cargoRoot) {
  const result = childProcess.spawnSync("cargo", ["metadata", "--format-version", "1", "--no-deps"], {
    cwd: cargoRoot,
    encoding: "utf8",
    stdio: ["inherit", "pipe", "pipe"],
    maxBuffer: 1024 * 1024 * 1024
  });
  if (result.error || result.status !== 0) {
    return null;
  }
  return JSON.parse(result.stdout);
}

function pathIsExcluded(relative, excludes) {
  const normalized = relative.replace(/\/+$/, "");
  return excludes.some((pattern) => {
    const normalizedPattern = pattern.replace(/\/+$/, "");
    return normalized === normalizedPattern
      || normalized.startsWith(normalizedPattern + "/")
      || fnmatch(normalized, normalizedPattern);
  });
}

function validWorkspaceMemberManifests(cargoRoot) {
  const data = loadToml(path.join(cargoRoot, "Cargo.toml"));
  const workspace = getTable(data, "workspace");
  const members = getTable(workspace, "members");
  const excludes = isObject(workspace) && "exclude" in workspace ? workspace.exclude : [];

  const manifests = [];
  const seen = new Set();

  if (truthy(getTable(data, "package").name)) {
    manifests.push(path.join(cargoRoot, "Cargo.toml"));
    seen.add(path.join(cargoRoot, "Cargo.toml"));
  }

  for (const member of Array.isArray(members) ? members : Object.keys(members)) {
    const candidates = member.includes("*")
      ? globPaths(cargoRoot, member).sort(comparePathParts)
      : [path.join(cargoRoot, member)];
    for (const candidate of candidates) {
      if (!isDir(candidate)) {
        continue;
      }
      if (pathIsExcluded(relativePath(candidate, cargoRoot), excludes)) {
        continue;
      }
      const manifest = path.join(candidate, "Cargo.toml");
      if (!isFile(manifest) || seen.has(manifest)) {
        continue;
      }
      manifests.push(manifest);
      seen.add(manifest);
    }
  }

  return manifests;
}

function packageName(manifest) {
  const name = getTable(loadToml(manifest), "package").name;
  return typeof name === "string" ? name : null;
}

function dependencyNamesFromTable(table) {
  const names = new Set();
  for (const [name, value] of Object.entries(table)) {
    if (isObject(value)) {
      names.add(typeof value.package === "string" ? value.package : name);
    } else {
      names.add(name);
    }
  }
  return names;
}

function manifestDependencyNames(manifest) {
  const data = loadToml(manifest);
  const names = new Set();
  const addTables = (container) => {
    for (const key of ["dependencies", "dev-dependencies", "build-dependencies"]) {
      const table = getTable(container, key);
      if (isObject(table)) {
        for (const name of dependencyNamesFromTable(table)) {
          names.add(name);
        }
      }
    }
  };
  addTables(data);
  const target = getTable(data, "target");
  if (isObject(target)) {
    for (const targetTable of Object.values(target)) {
      if (isObject(targetTable)) {
        addTables(targetTable);
      }
    }
  }
  return names;
}

function inferLayer(moduleCargoPath, cargoRoot, projectRoot) {
  if (moduleCargoPath === ".") {
    return ["root", relativePath(cargoRoot, projectRoot)];
  }
  const first = moduleCargoPath.split("/")[0];
  return [first, relativePath(path.join(cargoRoot, first), projectRoot)];
}

function rustFilesUnder(moduleDir, projectRoot, child) {
  const root = path.join(moduleDir, child);
  if (!isDir(root)) {
    return [];
  }
  return sortedStrings(walkFiles(root)
    .filter((candidate) => candidate.endsWith(".rs") && isFile(candidate))
    .filter((candidate) => !path.relative(moduleDir, candidate).split(path.sep).some((part) => RUST_EXCLUDED_DIRS.has(part)))
    .map((candidate) => relativePath(candidate, projectRoot)));
}

function workspacePatterns(packageData) {
  const workspaces = packageData.workspaces;
  if (Array.isArray(workspaces)) {
    return workspaces.filter((pattern) => typeof pattern === "string");
  }
  if (isObject(workspaces)) {
    const packages = "packages" in workspaces ? workspaces.packages : [];
    if (Array.isArray(packages)) {
      return packages.filter((pattern) => typeof pattern === "string");
    }
  }
  return [];
}

function nodeWorkspaceManifests(nodeRoot) {
  const rootManifest = path.join(nodeRoot, "package.json");
  const rootData = loadJson(rootManifest);
  const patterns = workspacePatterns(rootData);

  if (patterns.length === 0) {
    return [rootManifest];
  }

  const manifests = [];
  const seen = new Set();

  for (const pattern of patterns) {
    if (pattern.startsWith("!") || pattern.startsWith("/") || pattern.split("/").includes("..")) {
      continue;
    }
    const candidates = globPaths(nodeRoot, pattern)
      .sort((left, right) => compareStrings(toPosix(left), toPosix(right)));
    for (const candidate of candidates) {
      const manifest = path.join(candidate, "package.json");
      if (!isDir(candidate) || !isFile(manifest) || seen.has(manifest)) {
        continue;
      }
      if (relativePath(candidate, nodeRoot).split("/").some((part) => NODE_EXCLUDED_DIRS.has(part))) {
        continue;
      }
      manifests.push(manifest);
      seen.add(manifest);
    }
  }

  if (truthy(rootData.name) && (truthy(rootData.main) || truthy(rootData.exports) || isDir(path.join(nodeRoot, "src")))) {
    manifests.unshift(rootManifest);
  }

  return manifests;
}

function nodeDependencyNames(manifest) {
  const data = loadJson(manifest);
  const names = new Set();
  for (const tableName of NODE_DEPENDENCY_TABLES) {
    const table = getTable(data, tableName);
    if (isObject(table)) {
      for (const name of Object.keys(table)) {
        names.add(name);
      }
    }
  }
  return names;
}

function isNodeSource(candidate) {
  return NODE_SOURCE_EXTENSIONS.includes(pathSuffix(candidate)) && !path.basename(candidate).endsWith(".d.ts");
}

function hasExcludedNodePart(moduleDir, candidate) {
  return path.relative(moduleDir, candidate).split(path.sep).some((part) => NODE_EXCLUDED_DIRS.has(part));
}

function nodeSourceFilesUnder(moduleDir, projectRoot) {
  const sourceRoot = path.join(moduleDir, "src");
  if (!isDir(sourceRoot)) {
    return [[], []];
  }

  const sourceFiles = [];
  const testFiles = [];
  const byPosix = (left, right) => compareStrings(toPosix(left), toPosix(right));

  for (const candidate of walkFiles(sourceRoot).sort(byPosix)) {
    if (!isFile(candidate) || !isNodeSource(candidate) || hasExcludedNodePart(moduleDir, candidate)) {
      continue;
    }
    const relative = relativePath(candidate, projectRoot);
    if (NODE_TEST_MARKERS.some((marker) => path.basename(candidate).includes(marker))) {
      testFiles.push(relative);
    } else {
      sourceFiles.push(relative);
    }
  }

  const testsRoot = path.join(moduleDir, "tests");
  if (isDir(testsRoot)) {
    for (const candidate of walkFiles(testsRoot).sort(byPosix)) {
      if (isFile(candidate) && isNodeSource(candidate) && !hasExcludedNodePart(moduleDir, candidate)) {
        testFiles.push(relativePath(candidate, projectRoot));
      }
    }
  }

  return [sourceFiles, sortedStrings(new Set(testFiles))];
}

function inferNodeLayer(modulePath, nodeRoot, projectRoot) {
  const nodeRootRelative = relativePath(nodeRoot, projectRoot);
  if (modulePath === nodeRootRelative) {
    return ["root", nodeRootRelative];
  }
  const first = relativePath(path.join(projectRoot, modulePath), nodeRoot).split("/")[0];
  return [first, relativePath(path.join(nodeRoot, first), projectRoot)];
}

function recordsFromNames(namesByManifest, dependencyNames) {
  const workspaceNames = new Set(namesByManifest.values());
  return [...namesByManifest].map(([manifest, name]) => ({
    name,
    manifest,
    workspaceDependencies: sortedStrings([...dependencyNames(manifest)].filter((dependency) => workspaceNames.has(dependency)))
  }));
}

function nodePackageRecords(nodeRoot) {
  const namesByManifest = new Map();
  for (const manifest of nodeWorkspaceManifests(nodeRoot)) {
    const name = loadJson(manifest).name;
    if (typeof name === "string" && name) {
      namesByManifest.set(manifest, name);
    }
  }
  return recordsFromNames(namesByManifest, nodeDependencyNames);
}

function buildLayers(records, describe) {
  const layers = [];
  const layerByName = new Map();
  for (const record of records) {
    const moduleDir = path.dirname(record.manifest);
    const { layerName, layerPath, moduleEntry } = describe(record, moduleDir);
    if (!layerByName.has(layerName)) {
      const layer = { name: layerName, path: layerPath, modules: [] };
      layerByName.set(layerName, layer);
      layers.push(layer);
    }
    if (moduleEntry.path !== ".") {
      moduleEntry.architectureDoc = moduleEntry.path + "/ARCHITECTURE.md";
    }
    layerByName.get(layerName).modules.push(moduleEntry);
  }
  return layers;
}

function buildNodeIndex(projectRoot, nodeRoot) {
  const records = nodePackageRecords(nodeRoot);
  const hasWorkspaces = workspacePatterns(loadJson(path.join(nodeRoot, "package.json"))).length > 0;
  const layers = buildLayers(records, (record, moduleDir) => {
    const modulePath = relativePath(moduleDir, projectRoot);
    const [layerName, layerPath] = inferNodeLayer(modulePath, nodeRoot, projectRoot);
    const [sourceFiles, testFiles] = nodeSourceFilesUnder(moduleDir, projectRoot);
    return {
      layerName,
      layerPath,
      moduleEntry: {
        name: record.name,
        path: modulePath,
        manifest: relativePath(record.manifest, projectRoot),
        workspaceDependencies: record.workspaceDependencies,
        language: "typescript",
        files: { source: sourceFiles, tests: testFiles }
      }
    };
  });

  return {
    schemaVersion: 1,
    kind: "module-index",
    generatedBy: ".ai/tools/generate-module-index",
    workspace: {
      type: hasWorkspaces ? "npm-workspaces" : "npm-package",
      root: relativePath(nodeRoot, projectRoot),
      manifest: relativePath(path.join(nodeRoot, "package.json"), projectRoot)
    },
    layerInference: {
      method: "path-first-segment-from-workspace-root",
      rootPackageLayer: "root"
    },
    layers
  };
}

function packageRecordsFromMetadata(metadata) {
  const memberOrder = new Map(metadata.workspace_members.map((memberId, index) => [memberId, index]));
  const packages = metadata.packages
    .filter((pkg) => memberOrder.has(pkg.id))
    .sort((left, right) => memberOrder.get(left.id) - memberOrder.get(right.id));
  const workspaceNames = new Set(packages.map((pkg) => pkg.name));
  return packages.map((pkg) => ({
    name: pkg.name,
    manifest: pkg.manifest_path,
    workspaceDependencies: sortedStrings(new Set((pkg.dependencies || [])
      .filter((dependency) => workspaceNames.has(dependency.name))
      .map((dependency) => dependency.name)))
  }));
}

function packageRecordsFromManifests(cargoRoot) {
  const namesByManifest = new Map();
  for (const manifest of validWorkspaceMemberManifests(cargoRoot)) {
    const name = packageName(manifest);
    if (name !== null) {
      namesByManifest.set(manifest, name);
    }
  }
  return recordsFromNames(namesByManifest, manifestDependencyNames);
}

function buildCargoIndex(projectRoot, cargoRoot) {
  const metadata = loadCargoMetadata(cargoRoot);
  const records = metadata !== null ? packageRecordsFromMetadata(metadata) : packageRecordsFromManifests(cargoRoot);
  const layers = buildLayers(records, (record, moduleDir) => {
    const [layerName, layerPath] = inferLayer(relativePath(moduleDir, cargoRoot), cargoRoot, projectRoot);
    return {
      layerName,
      layerPath,
      moduleEntry: {
        name: record.name,
        path: relativePath(moduleDir, projectRoot),
        manifest: relativePath(record.manifest, projectRoot),
        workspaceDependencies: record.workspaceDependencies,
        files: {
          source: rustFilesUnder(moduleDir, projectRoot, "src"),
          tests: rustFilesUnder(moduleDir, projectRoot, "tests")
        }
      }
    };
  });

  return {
    schemaVersion: 1,
    kind: "module-index",
    generatedBy: ".ai/tools/generate-module-index",
    workspace: {
      root: relativePath(cargoRoot, projectRoot),
      manifest: relativePath(path.join(cargoRoot, "Cargo.toml"), projectRoot)
    },
    layerInference: {
      method: "path-first-segment-from-cargo-root",
      rootPackageLayer: "root"
    },
    layers
  };
}

function buildIndex(projectRoot) {
  const cargoRoot = maybeFindRoot(projectRoot, "Cargo.toml");
  if (cargoRoot !== null) {
    return buildCargoIndex(projectRoot, cargoRoot);
  }
  const nodeRoot = maybeFindRoot(projectRoot, "package.json");
  if (nodeRoot !== null) {
    return buildNodeIndex(projectRoot, nodeRoot);
  }
  return fail("Could not find Cargo.toml or package.json in " + projectRoot + " or its direct child directories.");
}

// Matches Python json.dumps(indent=2) with ensure_ascii.
function toJson(data) {
  return JSON.stringify(data, null, 2)
    .replace(/[\u007f-￿]/g, (character) => "\\u" + character.charCodeAt(0).toString(16).padStart(4, "0")) + "\n";
}

function parseArgs(argv) {
  const args = { check: false, print: false, output: ".ai/generated/module-index.json" };
  const usageError = (message) => {
    process.stderr.write(USAGE + "\ngenerate-module-index: error: " + message + "\n");
    process.exit(2);
  };
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "-h" || argument === "--help") {
      process.stdout.write(USAGE + "\n\nGenerate .ai/generated/module-index.json from Cargo or npm workspace metadata.\n");
      process.exit(0);
    } else if (argument === "--check") {
      args.check = true;
    } else if (argument === "--print") {
      args.print = true;
    } else if (argument === "--output" || argument.startsWith("--output=")) {
      if (argument === "--output") {
        if (index + 1 >= argv.length) {
          usageError("argument --output: expected one argument");
        }
        index += 1;
        args.output = argv[index];
      } else {
        args.output = argument.slice("--output=".length);
      }
    } else {
      usageError("unrecognized arguments: " + argv.slice(index).join(" "));
    }
  }
  return args;
}

function main(argv) {
  const args = parseArgs(argv);
  const root = path.resolve(path.dirname(fs.realpathSync(__filename)), "..", "..");
  const generated = toJson(buildIndex(root));
  const outputPath = path.join(root, args.output);
  const displayPath = toPosix(path.relative(root, outputPath));

  if (args.check) {
    if (!isFile(outputPath)) {
      process.stderr.write("Missing generated module index: " + displayPath + "\n");
      return 1;
    }
    if (fs.readFileSync(outputPath, "utf8").replace(/\r\n?/g, "\n") !== generated) {
      process.stderr.write("Stale generated module index: " + displayPath + "\n");
      return 1;
    }
    process.stdout.write("generate-module-index check passed\n");
    return 0;
  }

  if (args.print) {
    process.stdout.write(generated);
    return 0;
  }

  fs.mkdirSync(path.dirname(outputPath), { recursive: true });
  fs.writeFileSync(outputPath, generated);
  process.stdout.write("wrote " + displayPath + "\n");
  return 0;
}

try {
  process.exitCode = main(process.argv.slice(2));
} catch (error) {
  if (!(error instanceof ToolExit)) {
    throw error;
  }
  process.stderr.write(error.message + "\n");
  process.exitCode = 1;
}
