#!/usr/bin/env node
"use strict";
// Check that the architecture plan's Docs Impact covers every module the task
// touched. Without .ai/generated/module-index.json the repository is one module
// named "." whose owning doc is docs/ARCHITECTURE.md (or its docs/architecture/
// area docs).
//
// Usage:
//   .ai/tools/check-docs-sync [--base <commit>] [--json]
//
// The check compares the task's commits (base..HEAD, excluding [VCM Harness]
// commits) with .ai/generated/module-index.json and the Docs Impact table of
// .ai/vcm/handoffs/architecture-plan.md:
//   - every module touched by a code change had its owning architecture doc
//     changed in the task or has a Docs Impact row for that doc;
//   - a Docs Impact row that records no change gives its reason;
//   - every document Docs Impact records as changed was changed.
// A task without a complete architecture plan (an Architect Debug Flow or an
// Architecture Diagnosis Flow) is skipped.
// The base defaults to the merge-base of HEAD with the base repository's HEAD.

const childProcess = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

const HARNESS_COMMIT_PREFIX = "[VCM Harness] ";
const PLAN_PATH = ".ai/vcm/handoffs/architecture-plan.md";
const MODULE_INDEX_PATH = ".ai/generated/module-index.json";
const PROJECT_DOC = "docs/ARCHITECTURE.md";
const AREA_DOC_DIR = "docs/architecture/";
const USAGE = "usage: check-docs-sync [-h] [--base BASE] [--json]";

function usageError(message) {
  process.stderr.write(USAGE + "\ncheck-docs-sync: error: " + message + "\n");
  process.exit(2);
}

function parseArgs(argv) {
  const args = { base: undefined, json: false };
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "-h" || argument === "--help") {
      process.stdout.write(USAGE + "\n\nCheck that the architecture plan's Docs Impact covers every touched module.\n");
      process.exit(0);
    } else if (argument === "--json") {
      args.json = true;
    } else if (argument === "--base") {
      if (index + 1 >= argv.length) {
        usageError("argument " + argument + ": expected one argument");
      }
      index += 1;
      args.base = argv[index];
    } else {
      usageError("unrecognized arguments: " + argument);
    }
  }
  return args;
}

function git(root, args) {
  const result = childProcess.spawnSync("git", args, { cwd: root, encoding: "utf8", maxBuffer: 256 * 1024 * 1024 });
  return result.status === 0 ? result.stdout.trim() : "";
}

function repositoryRoot() {
  return git(process.cwd(), ["rev-parse", "--show-toplevel"]) || process.cwd();
}

// The task branch forks from the base repository's checked-out branch, which
// is the main worktree sharing this repository's git directory.
function resolveBase(root, explicit) {
  if (explicit) {
    return git(root, ["rev-parse", "--verify", explicit + "^{commit}"]) || undefined;
  }
  const fromEnv = (process.env.VCM_BASE_COMMIT || "").trim();
  if (fromEnv && git(root, ["rev-parse", "--verify", fromEnv + "^{commit}"])) {
    return fromEnv;
  }
  const commonDir = git(root, ["rev-parse", "--path-format=absolute", "--git-common-dir"]);
  const baseHead = commonDir ? git(root, ["--git-dir", commonDir, "rev-parse", "HEAD"]) : "";
  const head = git(root, ["rev-parse", "HEAD"]);
  if (baseHead && baseHead !== head) {
    return git(root, ["merge-base", "HEAD", baseHead]) || undefined;
  }
  const upstream = git(root, ["rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"]);
  return upstream ? git(root, ["merge-base", "HEAD", upstream]) || undefined : undefined;
}

function taskCommits(root, base) {
  const lines = git(root, ["log", "--format=%H%x09%s", base + "..HEAD"]).split("\n").filter(Boolean);
  return lines
    .map((line) => {
      const separator = line.indexOf("\t");
      return { sha: line.slice(0, separator), subject: line.slice(separator + 1) };
    })
    .filter((commit) => !commit.subject.startsWith(HARNESS_COMMIT_PREFIX))
    .map((commit) => ({
      ...commit,
      files: git(root, ["show", "--format=", "--name-only", "--no-renames", commit.sha]).split("\n").filter(Boolean)
    }));
}

function isArchitectureDoc(file) {
  return file === PROJECT_DOC || file.startsWith(AREA_DOC_DIR) || path.posix.basename(file) === "ARCHITECTURE.md";
}

// Files that describe or derive from code rather than change it.
function isDocumentationFile(file) {
  return isArchitectureDoc(file) || file.startsWith("docs/") || file.startsWith(".ai/") || /\.md$/i.test(file);
}

// The repository as one module, for projects without a module index (the
// generator supports Cargo and npm workspaces only).
const ROOT_MODULE = { name: ".", path: ".", doc: PROJECT_DOC };

function loadModules(root) {
  const target = path.join(root, MODULE_INDEX_PATH);
  if (!fs.existsSync(target)) {
    return [ROOT_MODULE];
  }
  const index = JSON.parse(fs.readFileSync(target, "utf8"));
  return (index.layers || []).flatMap((layer) => layer.modules || []).map((module) => ({
    name: module.name,
    path: module.path || ".",
    doc: module.path && module.path !== "." ? module.architectureDoc || module.path + "/ARCHITECTURE.md" : PROJECT_DOC
  }));
}

function owningModule(modules, file) {
  let best;
  for (const module of modules) {
    const prefix = module.path === "." ? "" : module.path + "/";
    if ((prefix === "" || file.startsWith(prefix)) && (!best || prefix.length > best.prefix.length)) {
      best = { module, prefix };
    }
  }
  return best && best.module;
}

function sectionContent(content, heading) {
  const match = new RegExp("^#{1,6}\\s+" + heading.replace(/[.*+?^${}()|[\]\\/]/g, "\\$&") + "\\s*$", "im").exec(content);
  if (!match) {
    return undefined;
  }
  const after = content.slice(match.index + match[0].length);
  const next = /\n#{1,6}\s+\S/.exec(after);
  return (next ? after.slice(0, next.index) : after).replace(/<!--[\s\S]*?-->/g, "").trim();
}

function tableRows(section) {
  const lines = (section || "").split(/\r?\n/).map((line) => line.trim()).filter((line) => line.startsWith("|"));
  return lines.slice(2).map((line) => line.replace(/^\|/, "").replace(/\|$/, "").split("|").map((cell) => cell.trim().replace(/^`|`$/g, "")));
}

function finding(code, subject, message) {
  return { code, subject, message };
}

function planIsComplete(content) {
  return /^Planning Result:\s*complete\s*$/im.test(content);
}

// A module's doc is the project doc or one of its area docs for the root module.
function documentsModule(module, document) {
  return module.doc === PROJECT_DOC
    ? document === PROJECT_DOC || document.startsWith(AREA_DOC_DIR)
    : document === module.doc;
}

function check(root, planContent, base) {
  const findings = [];
  const modules = loadModules(root);
  const commits = taskCommits(root, base);
  const changed = new Set(commits.flatMap((commit) => commit.files));

  const touched = new Map();
  for (const file of changed) {
    if (isDocumentationFile(file)) {
      continue;
    }
    const module = owningModule(modules, file);
    if (module) {
      touched.set(module.path, module);
    }
  }

  const rows = tableRows(sectionContent(planContent, "Docs Impact")).map(([documentCell, change, reason]) => ({
    document: (documentCell || "").split(/\s+/)[0],
    change: change || "",
    reason: reason || ""
  }));
  const docChanged = (module) => [...changed].some((file) => documentsModule(module, file));

  for (const module of touched.values()) {
    if (!docChanged(module) && !rows.some((row) => documentsModule(module, row.document))) {
      findings.push(finding("DS_MODULE_NOT_COVERED", module.path,
        "Module " + module.name + " (" + module.path + ") changed in the task, but neither its owning doc " + module.doc
          + " changed nor does Docs Impact list it with the reason no owned fact changed."));
    }
  }

  for (const row of rows) {
    if (!/\.md$/i.test(row.document)) {
      continue;
    }
    const unchanged = !row.change || /^(none|unchanged|no change)\b/i.test(row.change);
    if (unchanged && !/\w/.test(row.reason.replace(/^(none|tbd)\.?$/i, ""))) {
      findings.push(finding("DS_UNCHANGED_WITHOUT_REASON", row.document,
        "Docs Impact records no change to " + row.document + " without the reason no owned fact changed."));
    } else if (!unchanged && !changed.has(row.document)) {
      findings.push(finding("DS_PLANNED_DOC_NOT_CHANGED", row.document,
        "Docs Impact records a change to " + row.document + ", but the task did not change it."));
    }
  }
  return findings;
}

function main() {
  const args = parseArgs(process.argv.slice(2));
  const root = repositoryRoot();
  const planPath = path.join(root, PLAN_PATH);
  const plan = fs.existsSync(planPath) ? fs.readFileSync(planPath, "utf8") : "";
  if (!planIsComplete(plan)) {
    const reason = "No complete " + PLAN_PATH + "; the task has no Docs Impact to check.";
    process.stdout.write(args.json ? JSON.stringify({ skipped: reason, findings: [] }, null, 2) + "\n" : reason + "\n");
    return 0;
  }
  const base = resolveBase(root, args.base);
  if (!base) {
    process.stderr.write("check-docs-sync: cannot determine the task base commit; pass --base <commit>.\n");
    return 2;
  }
  const findings = check(root, plan, base);
  if (args.json) {
    process.stdout.write(JSON.stringify({ base, findings }, null, 2) + "\n");
  } else if (findings.length === 0) {
    process.stdout.write("Docs sync check passed.\n");
  } else {
    for (const item of findings) {
      process.stdout.write(item.code + " " + item.subject + ": " + item.message + "\n");
    }
  }
  return findings.length === 0 ? 0 : 1;
}

process.exitCode = main();
