#!/usr/bin/env node
"use strict";
// Generate .ai/generated/public-surface.json from Rust or TypeScript source files.

const fs = require("node:fs");
const path = require("node:path");

const IDENTIFIER = /[A-Za-z_][A-Za-z0-9_]*/y;
const IDENTIFIER_FULL = /^[A-Za-z_][A-Za-z0-9_]*$/;
const ITEM_KINDS = { fn: "fn", struct: "struct", enum: "enum", trait: "trait" };
const ITEM_MODIFIERS = new Set(["async", "const", "unsafe", "extern"]);
const BLOCK_ITEM_KEYWORDS = new Set([
  "fn",
  "struct",
  "enum",
  "trait",
  "impl",
  "mod",
  "const",
  "static",
  "type",
  "union",
  "macro_rules"
]);
const TS_SOURCE_EXTENSIONS = [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"];
const TS_ITEM_KINDS = ["function", "class", "interface", "type", "enum", "variable"];
const TS_EXPORT_DECLARATION = /\bexport\s+(?:default\s+)?(?:declare\s+)?(?:(?:async\s+)?function\s+(?<function>[A-Za-z_$][A-Za-z0-9_$]*)|class\s+(?<class>[A-Za-z_$][A-Za-z0-9_$]*)|interface\s+(?<interface>[A-Za-z_$][A-Za-z0-9_$]*)|type\s+(?<type>[A-Za-z_$][A-Za-z0-9_$]*)|enum\s+(?<enum>[A-Za-z_$][A-Za-z0-9_$]*)|(?:const|let|var)\s+(?<variable>[A-Za-z_$][A-Za-z0-9_$]*))/g;
const TS_REEXPORT = /\bexport\s+(?:type\s+)?(?<form>\*|\{[^}]*\})\s+from\s+(?<quote>["'`])(?<specifier>[^"'`]+)\k<quote>/g;
const TS_ROUTE_CALL = /\.\s*(?<method>get|post|put|patch|delete|options|head)\s*(?:<(?:(?!>\s*\()[\s\S])*>\s*)?\(\s*(?<quote>["'`])(?<path>[^"'`]+)\k<quote>/gi;
const TS_ROUTE_OBJECT = /\.route\s*\(\s*\{(?<body>.*?)\}\s*\)/gis;
const TS_ROUTE_METHOD = /\bmethod\s*:\s*(?<quote>["'`])(?<method>[A-Za-z]+)\k<quote>/i;
const TS_ROUTE_URL = /\b(?:url|path)\s*:\s*(?<quote>["'`])(?<path>[^"'`]+)\k<quote>/i;
const USAGE = "usage: generate-public-surface [-h] [--check] [--print] [--output OUTPUT]";

class ToolExit extends Error {}

function fail(message) {
  throw new ToolExit(message);
}

function isObject(value) {
  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
}

function get(container, key, fallback) {
  return isObject(container) && key in container ? container[key] : fallback;
}

function isFile(target) {
  try {
    return fs.statSync(target).isFile();
  } catch {
    return false;
  }
}

function readText(target) {
  return fs.readFileSync(target, "utf8").replace(/\r\n?/g, "\n");
}

function resolvePath(target) {
  const absolute = path.resolve(target);
  try {
    return fs.realpathSync(absolute);
  } catch {
    const parent = path.dirname(absolute);
    return parent === absolute ? absolute : path.join(resolvePath(parent), path.basename(absolute));
  }
}

function isInside(relative) {
  return relative !== ".." && !relative.startsWith(".." + path.sep) && !path.isAbsolute(relative);
}

function relativePath(target, root) {
  let relative = path.relative(path.resolve(root), path.resolve(target));
  if (!isInside(relative)) {
    relative = path.relative(resolvePath(root), resolvePath(target));
    if (!isInside(relative)) {
      fail("'" + target + "' is not in the subpath of '" + root + "'");
    }
  }
  return relative === "" ? "." : relative.split(path.sep).join("/");
}

function pathSuffix(target) {
  const name = path.basename(target);
  const index = name.lastIndexOf(".");
  return index > 0 && index < name.length - 1 ? name.slice(index) : "";
}

function withSuffix(target, suffix) {
  const current = pathSuffix(target);
  return (current ? target.slice(0, -current.length) : target) + suffix;
}

function isSpace(character) {
  return /\s/.test(character);
}

function isAlpha(character) {
  return /\p{L}/u.test(character);
}

function collapseWhitespace(text) {
  return text.split(/\s+/).filter(Boolean).join(" ");
}

function uniqueItems(items) {
  const seen = new Set();
  return items.filter((item) => {
    const key = JSON.stringify([item.path, item.kind, item.source.path, item.source.line]);
    if (seen.has(key)) {
      return false;
    }
    seen.add(key);
    return true;
  });
}

function loadModuleIndex(root) {
  const target = path.join(root, ".ai/generated/module-index.json");
  if (!isFile(target)) {
    fail("Missing .ai/generated/module-index.json; run .ai/tools/generate-module-index first.");
  }
  return JSON.parse(readText(target));
}

function loadOptionalJson(target) {
  if (!isFile(target)) {
    return {};
  }
  return JSON.parse(readText(target));
}

function lineNumberFromOffset(source, offset) {
  let count = 1;
  for (let index = source.indexOf("\n"); index >= 0 && index < offset; index = source.indexOf("\n", index + 1)) {
    count += 1;
  }
  return count;
}

function countNewlines(text) {
  return text.split("\n").length - 1;
}

function rawStringEnd(source, index) {
  for (const prefix of ["br", "rb", "r"]) {
    if (!source.startsWith(prefix, index)) {
      continue;
    }
    let cursor = index + prefix.length;
    let hashes = 0;
    while (cursor < source.length && source[cursor] === "#") {
      hashes += 1;
      cursor += 1;
    }
    if (cursor >= source.length || source[cursor] !== "\"") {
      continue;
    }
    const delimiter = "\"" + "#".repeat(hashes);
    const end = source.indexOf(delimiter, cursor + 1);
    return end === -1 ? source.length : end + delimiter.length;
  }
  return null;
}

function quotedLiteralEnd(source, index) {
  const quote = source[index];
  let escaped = false;
  for (let cursor = index + 1; cursor < source.length; cursor += 1) {
    const character = source[cursor];
    if (escaped) {
      escaped = false;
    } else if (character === "\\") {
      escaped = true;
    } else if (character === quote) {
      return cursor + 1;
    }
  }
  return source.length;
}

function blockCommentEnd(source, index) {
  let cursor = index + 2;
  let depth = 1;
  while (cursor < source.length && depth) {
    if (source.startsWith("/*", cursor)) {
      depth += 1;
      cursor += 2;
    } else if (source.startsWith("*/", cursor)) {
      depth -= 1;
      cursor += 2;
    } else {
      cursor += 1;
    }
  }
  return cursor;
}

function isByteStringStart(source, cursor) {
  return source[cursor] === "\"" || (source[cursor] === "b" && cursor + 1 < source.length && source[cursor + 1] === "\"");
}

function isCharLiteralStart(source, cursor) {
  return source[cursor] === "'" && cursor + 1 < source.length && !isAlpha(source[cursor + 1]);
}

function scanTokens(source) {
  const tokens = [];
  let cursor = 0;
  let line = 1;

  while (cursor < source.length) {
    const character = source[cursor];

    if (isSpace(character)) {
      if (character === "\n") {
        line += 1;
      }
      cursor += 1;
      continue;
    }

    if (source.startsWith("//", cursor)) {
      const end = source.indexOf("\n", cursor + 2);
      cursor = end === -1 ? source.length : end;
      continue;
    }

    if (source.startsWith("/*", cursor)) {
      const end = blockCommentEnd(source, cursor);
      line += countNewlines(source.slice(cursor, end));
      cursor = end;
      continue;
    }

    const rawEnd = rawStringEnd(source, cursor);
    if (rawEnd !== null) {
      line += countNewlines(source.slice(cursor, rawEnd));
      cursor = rawEnd;
      continue;
    }

    if (isByteStringStart(source, cursor)) {
      const end = quotedLiteralEnd(source, character === "b" ? cursor + 1 : cursor);
      line += countNewlines(source.slice(cursor, end));
      cursor = end;
      continue;
    }

    if (isCharLiteralStart(source, cursor)) {
      const end = quotedLiteralEnd(source, cursor);
      line += countNewlines(source.slice(cursor, end));
      cursor = end;
      continue;
    }

    IDENTIFIER.lastIndex = cursor;
    const match = IDENTIFIER.exec(source);
    if (match) {
      tokens.push({ value: match[0], start: cursor, end: IDENTIFIER.lastIndex, line });
      cursor = IDENTIFIER.lastIndex;
      continue;
    }

    tokens.push({ value: character, start: cursor, end: cursor + 1, line });
    cursor += 1;
  }

  return tokens;
}

function removeCommentsPreserveLiterals(text) {
  const output = [];
  let cursor = 0;
  while (cursor < text.length) {
    if (text.startsWith("//", cursor)) {
      const end = text.indexOf("\n", cursor + 2);
      if (end === -1) {
        break;
      }
      output.push("\n");
      cursor = end + 1;
      continue;
    }

    if (text.startsWith("/*", cursor)) {
      const end = blockCommentEnd(text, cursor);
      output.push("\n".repeat(countNewlines(text.slice(cursor, end))));
      cursor = end;
      continue;
    }

    const rawEnd = rawStringEnd(text, cursor);
    if (rawEnd !== null) {
      output.push(text.slice(cursor, rawEnd));
      cursor = rawEnd;
      continue;
    }

    const character = text[cursor];
    if (isByteStringStart(text, cursor)) {
      const end = quotedLiteralEnd(text, character === "b" ? cursor + 1 : cursor);
      output.push(text.slice(cursor, end));
      cursor = end;
      continue;
    }

    if (isCharLiteralStart(text, cursor)) {
      const end = quotedLiteralEnd(text, cursor);
      output.push(text.slice(cursor, end));
      cursor = end;
      continue;
    }

    output.push(character);
    cursor += 1;
  }

  return output.join("");
}

function normalizeSignature(signature) {
  return collapseWhitespace(removeCommentsPreserveLiterals(signature));
}

function trackDepth(depth, character) {
  if (character === "<") {
    depth.angle += 1;
  } else if (character === ">" && depth.angle) {
    depth.angle -= 1;
  } else if (character === "(") {
    depth.paren += 1;
  } else if (character === ")" && depth.paren) {
    depth.paren -= 1;
  } else if (character === "[") {
    depth.bracket += 1;
  } else if (character === "]" && depth.bracket) {
    depth.bracket -= 1;
  }
  return depth.angle === 0 && depth.paren === 0 && depth.bracket === 0;
}

function signatureFromSource(source, start) {
  let cursor = start;
  const depth = { angle: 0, paren: 0, bracket: 0 };

  while (cursor < source.length) {
    if (source.startsWith("//", cursor)) {
      const end = source.indexOf("\n", cursor + 2);
      cursor = end === -1 ? source.length : end;
      continue;
    }

    if (source.startsWith("/*", cursor)) {
      cursor = blockCommentEnd(source, cursor);
      continue;
    }

    const rawEnd = rawStringEnd(source, cursor);
    if (rawEnd !== null) {
      cursor = rawEnd;
      continue;
    }

    const character = source[cursor];
    if (isByteStringStart(source, cursor)) {
      cursor = quotedLiteralEnd(source, character === "b" ? cursor + 1 : cursor);
      continue;
    }

    if (isCharLiteralStart(source, cursor)) {
      cursor = quotedLiteralEnd(source, cursor);
      continue;
    }

    if (trackDepth(depth, character) && (character === "{" || character === ";")) {
      return normalizeSignature(source.slice(start, cursor));
    }

    cursor += 1;
  }

  return normalizeSignature(source.slice(start));
}

function childModuleCandidates(currentFile, moduleName) {
  const base = ["lib.rs", "main.rs", "mod.rs"].includes(path.basename(currentFile))
    ? path.dirname(currentFile)
    : withSuffix(currentFile, "");
  return [path.join(base, moduleName + ".rs"), path.join(base, moduleName, "mod.rs")];
}

function isBarePub(tokens, index) {
  return tokens[index].value === "pub" && !(index + 1 < tokens.length && tokens[index + 1].value === "(");
}

function publicDeclAt(tokens, index) {
  if (!isBarePub(tokens, index)) {
    return null;
  }

  let cursor = index + 1;
  while (cursor < tokens.length && ITEM_MODIFIERS.has(tokens[cursor].value)) {
    cursor += 1;
  }

  if (cursor >= tokens.length) {
    return null;
  }

  const kind = tokens[cursor].value;
  if (kind === "mod") {
    if (cursor + 1 < tokens.length && IDENTIFIER_FULL.test(tokens[cursor + 1].value)) {
      return { kind: "mod", name: tokens[cursor + 1].value, pubIndex: index, keywordIndex: cursor, nameIndex: cursor + 1 };
    }
    return null;
  }

  if (Object.hasOwn(ITEM_KINDS, kind) && cursor + 1 < tokens.length) {
    const name = tokens[cursor + 1].value;
    if (IDENTIFIER_FULL.test(name)) {
      return { kind: ITEM_KINDS[kind], name, pubIndex: index, keywordIndex: cursor, nameIndex: cursor + 1 };
    }
  }

  return null;
}

function skipBraceBlock(tokens, index) {
  let depth = 0;
  let cursor = index;
  while (cursor < tokens.length) {
    if (tokens[cursor].value === "{") {
      depth += 1;
    } else if (tokens[cursor].value === "}") {
      depth -= 1;
      if (depth === 0) {
        return cursor + 1;
      }
    }
    cursor += 1;
  }
  return cursor;
}

function skipItem(tokens, index) {
  for (let cursor = index; cursor < tokens.length; cursor += 1) {
    if (tokens[cursor].value === ";") {
      return cursor + 1;
    }
    if (tokens[cursor].value === "{") {
      return skipBraceBlock(tokens, cursor);
    }
  }
  return tokens.length;
}

function fileModuleParts(sourceFile, module) {
  const modulePath = get(module, "path", ".");
  const prefix = modulePath === "." ? "src/" : modulePath + "/src/";
  if (sourceFile.endsWith("/src/lib.rs") || sourceFile.endsWith("/src/main.rs")) {
    return [];
  }
  let relative = sourceFile.startsWith(prefix) ? sourceFile.slice(prefix.length) : sourceFile;
  relative = relative.endsWith(".rs") ? relative.slice(0, -3) : relative;
  return relative.split("/").filter((part) => part && part !== "mod");
}

function joinPath(parts) {
  return parts.join("::");
}

function publicPath(parts, itemName) {
  return joinPath([...parts, itemName]);
}

function isPathSeparator(tokens, index) {
  return index + 1 < tokens.length && tokens[index].value === ":" && tokens[index + 1].value === ":";
}

function publicFileModuleNames(source) {
  const tokens = scanTokens(source);
  const names = [];
  tokens.forEach((token, index) => {
    if (token.value !== "pub") {
      return;
    }
    const decl = publicDeclAt(tokens, index);
    if (decl === null || decl.kind !== "mod") {
      return;
    }
    if (decl.nameIndex + 1 < tokens.length && tokens[decl.nameIndex + 1].value === ";") {
      names.push(decl.name);
    }
  });
  return names;
}

function parsePubUseExports(source) {
  const tokens = scanTokens(source);
  const exports = [];

  function parseGroup(index, prefix) {
    let cursor = index + 1;
    while (cursor < tokens.length) {
      if (tokens[cursor].value === "}") {
        return cursor + 1;
      }
      if (tokens[cursor].value === ",") {
        cursor += 1;
        continue;
      }
      cursor = parseTree(cursor, prefix);
      if (cursor < tokens.length && tokens[cursor].value === ",") {
        cursor += 1;
      }
    }
    return cursor;
  }

  function parseTree(index, prefix) {
    let cursor = index;
    const parts = [...prefix];

    while (cursor < tokens.length) {
      const token = tokens[cursor];

      if (token.value === "{") {
        return parseGroup(cursor, parts);
      }

      if (token.value === "*") {
        exports.push({ path: [...parts], alias: null, wildcard: true });
        return cursor + 1;
      }

      if (!IDENTIFIER_FULL.test(token.value)) {
        return cursor + 1;
      }

      const name = token.value;
      if (name === "self") {
        cursor += 1;
        if (isPathSeparator(tokens, cursor)) {
          cursor += 2;
          continue;
        }
        return cursor;
      }

      parts.push(name);
      cursor += 1;

      if (isPathSeparator(tokens, cursor)) {
        cursor += 2;
        continue;
      }

      let alias = null;
      if (cursor + 1 < tokens.length && tokens[cursor].value === "as") {
        if (IDENTIFIER_FULL.test(tokens[cursor + 1].value)) {
          alias = tokens[cursor + 1].value;
          cursor += 2;
        }
      }

      exports.push({ path: [...parts], alias, wildcard: false });
      return cursor;
    }

    return cursor;
  }

  let index = 0;
  while (index < tokens.length) {
    if (
      tokens[index].value === "pub"
      && isBarePub(tokens, index)
      && index + 1 < tokens.length
      && tokens[index + 1].value === "use"
    ) {
      let cursor = parseTree(index + 2, []);
      while (cursor < tokens.length && tokens[cursor].value !== ";") {
        cursor += 1;
      }
      index = cursor + 1;
      continue;
    }
    index += 1;
  }

  return exports;
}

function definesPath(parts, definitions) {
  const joined = joinPath(parts);
  return definitions.has(joined) || [...definitions.keys()].some((key) => key.startsWith(joined + "::"));
}

function resolveUsePath(parts, currentParts, definitions) {
  if (parts.length === 0) {
    return null;
  }

  if (parts[0] === "crate") {
    return parts.slice(1);
  }

  if (parts[0] === "self") {
    return [...currentParts, ...parts.slice(1)];
  }

  if (parts[0] === "super") {
    let cursor = 0;
    const base = [...currentParts];
    while (cursor < parts.length && parts[cursor] === "super") {
      base.pop();
      cursor += 1;
    }
    return [...base, ...parts.slice(cursor)];
  }

  if (definesPath(parts, definitions)) {
    return parts;
  }

  const relative = [...currentParts, ...parts];
  if (definesPath(relative, definitions)) {
    return relative;
  }

  return null;
}

function reexportedItemsFromSource(source, sourceFile, module, definitions) {
  const items = [];
  const currentParts = fileModuleParts(sourceFile, module);

  for (const exported of parsePubUseExports(source)) {
    const targetParts = resolveUsePath(exported.path, currentParts, definitions);
    if (targetParts === null) {
      continue;
    }

    const targetPath = joinPath(targetParts);

    if (exported.wildcard) {
      const prefix = targetPath + "::";
      for (const [definitionPath, definition] of definitions) {
        if (!definitionPath.startsWith(prefix) || definitionPath.slice(prefix.length).includes("::")) {
          continue;
        }
        items.push({ ...definition, path: publicPath(currentParts, definition.name) });
      }
      continue;
    }

    const definition = definitions.get(targetPath);
    if (definition === undefined) {
      continue;
    }
    const name = exported.alias || definition.name;
    items.push({ ...definition, path: publicPath(currentParts, name), name });
  }

  return items;
}

function moduleSourceFiles(module) {
  return get(get(module, "files", {}), "source", []);
}

function moduleRoot(root, module) {
  const modulePath = get(module, "path", ".");
  return modulePath === "." ? root : path.join(root, modulePath);
}

function indexedSourceMap(root, module) {
  return new Map(moduleSourceFiles(module).map((sourceFile) => [resolvePath(path.join(root, sourceFile)), sourceFile]));
}

function reachablePublicSourceFiles(root, module) {
  const indexedSources = indexedSourceMap(root, module);
  const crateRoots = [path.join(moduleRoot(root, module), "src/lib.rs"), path.join(moduleRoot(root, module), "src/main.rs")];
  const reachable = [];
  const visited = new Set();

  function visit(target) {
    const resolved = resolvePath(target);
    if (visited.has(resolved) || !indexedSources.has(resolved)) {
      return;
    }
    visited.add(resolved);
    reachable.push(indexedSources.get(resolved));

    for (const moduleName of publicFileModuleNames(readText(target))) {
      for (const candidate of childModuleCandidates(target, moduleName)) {
        if (indexedSources.has(resolvePath(candidate))) {
          visit(candidate);
          break;
        }
      }
    }
  }

  for (const crateRoot of crateRoots) {
    if (indexedSources.has(resolvePath(crateRoot))) {
      visit(crateRoot);
      break;
    }
  }

  return reachable;
}

function extractItemsFromSource(source, sourceFile, module) {
  const tokens = scanTokens(source);
  const items = [];

  function parseScope(startIndex, pathParts, stopAtBrace) {
    let cursor = startIndex;
    while (cursor < tokens.length) {
      const token = tokens[cursor];

      if (stopAtBrace && token.value === "}") {
        return cursor + 1;
      }

      if (token.value === "pub") {
        const decl = publicDeclAt(tokens, cursor);
        if (decl !== null) {
          const afterName = decl.nameIndex + 1;
          if (decl.kind === "mod") {
            if (afterName < tokens.length && tokens[afterName].value === "{") {
              cursor = parseScope(afterName + 1, [...pathParts, decl.name], true);
              continue;
            }
            cursor = skipItem(tokens, cursor);
            continue;
          }

          items.push({
            path: publicPath(pathParts, decl.name),
            kind: decl.kind,
            name: decl.name,
            source: { path: sourceFile, line: tokens[decl.pubIndex].line },
            signature: signatureFromSource(source, tokens[decl.pubIndex].start)
          });
          cursor = skipItem(tokens, cursor);
          continue;
        }
      }

      if (BLOCK_ITEM_KEYWORDS.has(token.value)) {
        cursor = skipItem(tokens, cursor);
        continue;
      }

      if (token.value === "{") {
        cursor = skipBraceBlock(tokens, cursor);
        continue;
      }

      cursor += 1;
    }

    return cursor;
  }

  parseScope(0, fileModuleParts(sourceFile, module), false);
  return items;
}

function readModuleSource(root, sourceFile) {
  const target = path.join(root, sourceFile);
  if (!isFile(target)) {
    fail("Missing source file from module index: " + sourceFile);
  }
  return readText(target);
}

function extractPublicItems(root, module) {
  const definitions = new Map();
  for (const sourceFile of moduleSourceFiles(module)) {
    for (const item of extractItemsFromSource(readModuleSource(root, sourceFile), sourceFile, module)) {
      if (!definitions.has(item.path)) {
        definitions.set(item.path, item);
      }
    }
  }

  const items = [];
  for (const sourceFile of reachablePublicSourceFiles(root, module)) {
    const source = readModuleSource(root, sourceFile);
    items.push(...extractItemsFromSource(source, sourceFile, module));
    items.push(...reexportedItemsFromSource(source, sourceFile, module, definitions));
  }

  return uniqueItems(items);
}

function removeTsCommentsPreserveLiterals(source) {
  const output = [];
  let cursor = 0;
  let quote = null;
  let escaped = false;

  while (cursor < source.length) {
    const character = source[cursor];

    if (quote !== null) {
      output.push(character);
      if (escaped) {
        escaped = false;
      } else if (character === "\\") {
        escaped = true;
      } else if (character === quote) {
        quote = null;
      }
      cursor += 1;
      continue;
    }

    if (source.startsWith("//", cursor)) {
      const end = source.indexOf("\n", cursor + 2);
      if (end === -1) {
        output.push(" ".repeat(source.length - cursor));
        break;
      }
      output.push(" ".repeat(end - cursor));
      output.push("\n");
      cursor = end + 1;
      continue;
    }

    if (source.startsWith("/*", cursor)) {
      const found = source.indexOf("*/", cursor + 2);
      const end = found === -1 ? source.length : found + 2;
      output.push(source.slice(cursor, end).replace(/[^\n]/g, " "));
      cursor = end;
      continue;
    }

    if (character === "'" || character === "\"" || character === "`") {
      quote = character;
      escaped = false;
      output.push(character);
      cursor += 1;
      continue;
    }

    output.push(character);
    cursor += 1;
  }

  return output.join("");
}

function tsSignatureFromSource(source, start) {
  let cursor = start;
  const depth = { angle: 0, paren: 0, bracket: 0 };
  let backtickSource = null;

  while (cursor < source.length) {
    const character = source[cursor];
    if (character === "'" || character === "\"") {
      cursor = quotedLiteralEnd(source, cursor);
      continue;
    }
    if (character === "`") {
      backtickSource = backtickSource || source.replace(/`/g, "\"");
      cursor = quotedLiteralEnd(backtickSource, cursor);
      continue;
    }

    if (trackDepth(depth, character) && (character === "{" || character === ";")) {
      return collapseWhitespace(source.slice(start, cursor));
    }
    cursor += 1;
  }

  return collapseWhitespace(source.slice(start));
}

function tsItemKind(match) {
  for (const kind of TS_ITEM_KINDS) {
    const name = match.groups[kind];
    if (name) {
      return [kind === "variable" ? "const" : kind, name];
    }
  }
  return null;
}

function extractTsExportedDeclarations(source, sourceFile) {
  const sanitized = removeTsCommentsPreserveLiterals(source);
  const items = [];

  for (const match of sanitized.matchAll(TS_EXPORT_DECLARATION)) {
    const kindAndName = tsItemKind(match);
    if (kindAndName === null) {
      continue;
    }
    const [kind, name] = kindAndName;
    items.push({
      path: name,
      kind,
      name,
      source: { path: sourceFile, line: lineNumberFromOffset(sanitized, match.index) },
      signature: tsSignatureFromSource(source, match.index)
    });
  }

  return items;
}

function exportedNamesFromGroup(group) {
  const names = [];
  const body = group.trim().slice(1, -1);
  for (const rawPart of body.split(",")) {
    let part = rawPart.trim();
    if (!part) {
      continue;
    }
    if (part.startsWith("type ")) {
      part = part.slice("type ".length).trim();
    }
    const separator = /\s+as\s+/.exec(part);
    const pieces = separator
      ? [part.slice(0, separator.index).trim(), part.slice(separator.index + separator[0].length).trim()]
      : [part.trim()];
    const sourceName = pieces[0];
    const publicName = pieces.length === 2 ? pieces[1] : sourceName;
    if (sourceName && sourceName !== "default") {
      names.push([sourceName, publicName]);
    }
  }
  return names;
}

function resolveTsSpecifier(currentFile, specifier, indexedSources) {
  if (!specifier.startsWith(".")) {
    return null;
  }

  const base = resolvePath(path.join(path.dirname(currentFile), specifier));
  const candidates = [];

  if (pathSuffix(base)) {
    candidates.push(base);
    for (const extension of TS_SOURCE_EXTENSIONS) {
      candidates.push(withSuffix(base, extension));
    }
  } else {
    for (const extension of TS_SOURCE_EXTENSIONS) {
      candidates.push(withSuffix(base, extension));
    }
    for (const extension of TS_SOURCE_EXTENSIONS) {
      candidates.push(path.join(base, "index" + extension));
    }
  }

  for (const candidate of candidates) {
    const sourceFile = indexedSources.get(resolvePath(candidate));
    if (sourceFile !== undefined) {
      return sourceFile;
    }
  }

  return null;
}

function packageExportTargets(value) {
  if (typeof value === "string") {
    return [value];
  }
  if (Array.isArray(value)) {
    return value.flatMap(packageExportTargets);
  }
  if (isObject(value)) {
    return Object.entries(value)
      .filter(([key]) => ["types", "import", "require", "default", "module"].includes(key) || key.startsWith("."))
      .flatMap(([, item]) => packageExportTargets(item));
  }
  return [];
}

function tsEntrypointFiles(root, module) {
  const indexedSources = new Set(moduleSourceFiles(module));
  const modulePath = get(module, "path", ".");
  const base = moduleRoot(root, module);
  const manifest = loadOptionalJson(path.join(root, get(module, "manifest", "")));
  const targets = ["exports", "main", "module", "types"].flatMap((key) => packageExportTargets(get(manifest, key, null)));

  const candidates = [];
  for (const target of targets) {
    const targetPath = resolvePath(path.resolve(base, target));
    for (const candidate of [targetPath, ...TS_SOURCE_EXTENSIONS.map((extension) => withSuffix(targetPath, extension))]) {
      const relative = relativePath(candidate, root);
      if (indexedSources.has(relative)) {
        candidates.push(relative);
      }
    }
  }

  if (candidates.length === 0) {
    for (const name of ["index", "main", "app"]) {
      for (const extension of TS_SOURCE_EXTENSIONS) {
        const relative = relativePath(path.join(base, "src", name + extension), root);
        if (indexedSources.has(relative)) {
          candidates.push(relative);
        }
      }
    }
  }

  if (candidates.length === 0 && modulePath.startsWith("apps/")) {
    candidates.push(...moduleSourceFiles(module));
  }

  return [...new Set(candidates)].sort((left, right) => (left < right ? -1 : left > right ? 1 : 0));
}

function collectTsPublicItems(root, sourceFile, module, directDefinitions, indexedSources, visited) {
  if (visited.has(sourceFile)) {
    return [];
  }
  visited.add(sourceFile);

  const target = path.join(root, sourceFile);
  const sanitized = removeTsCommentsPreserveLiterals(readText(target));
  const items = [...(directDefinitions.get(sourceFile) || new Map()).values()];

  for (const match of sanitized.matchAll(TS_REEXPORT)) {
    const targetFile = resolveTsSpecifier(target, match.groups.specifier, indexedSources);
    if (targetFile === null) {
      continue;
    }

    const form = match.groups.form;
    if (form === "*") {
      items.push(...collectTsPublicItems(root, targetFile, module, directDefinitions, indexedSources, visited));
      continue;
    }

    const targetDefinitions = directDefinitions.get(targetFile) || new Map();
    for (const [sourceName, publicName] of exportedNamesFromGroup(form)) {
      const definition = targetDefinitions.get(sourceName);
      if (definition === undefined) {
        items.push({
          path: publicName,
          kind: "re-export",
          name: publicName,
          source: { path: sourceFile, line: lineNumberFromOffset(sanitized, match.index) }
        });
        continue;
      }
      items.push({ ...definition, path: publicName, name: publicName });
    }
  }

  return items;
}

function routeItem(name, sourceFile, sanitized, offset) {
  return {
    path: name,
    kind: "route",
    name,
    source: { path: sourceFile, line: lineNumberFromOffset(sanitized, offset) }
  };
}

function extractTsRoutes(source, sourceFile) {
  const sanitized = removeTsCommentsPreserveLiterals(source);
  const items = [];

  for (const match of sanitized.matchAll(TS_ROUTE_CALL)) {
    items.push(routeItem(match.groups.method.toUpperCase() + " " + match.groups.path, sourceFile, sanitized, match.index));
  }

  for (const match of sanitized.matchAll(TS_ROUTE_OBJECT)) {
    const body = match.groups.body;
    const methodMatch = TS_ROUTE_METHOD.exec(body);
    const pathMatch = TS_ROUTE_URL.exec(body);
    if (methodMatch === null || pathMatch === null) {
      continue;
    }
    items.push(routeItem(methodMatch.groups.method.toUpperCase() + " " + pathMatch.groups.path, sourceFile, sanitized, match.index));
  }

  return items;
}

function extractTypescriptPublicItems(root, module) {
  const indexedSources = indexedSourceMap(root, module);
  const directDefinitions = new Map();

  for (const sourceFile of moduleSourceFiles(module)) {
    const definitions = new Map();
    for (const item of extractTsExportedDeclarations(readModuleSource(root, sourceFile), sourceFile)) {
      definitions.set(item.name, item);
    }
    directDefinitions.set(sourceFile, definitions);
  }

  let entrypoints = tsEntrypointFiles(root, module);
  if (entrypoints.length === 0) {
    entrypoints = [...moduleSourceFiles(module)];
  }

  const items = [];
  for (const entrypoint of entrypoints) {
    items.push(...collectTsPublicItems(root, entrypoint, module, directDefinitions, indexedSources, new Set()));
  }

  if (get(module, "path", "").startsWith("apps/")) {
    for (const sourceFile of moduleSourceFiles(module)) {
      items.push(...extractTsRoutes(readText(path.join(root, sourceFile)), sourceFile));
    }
  }

  return uniqueItems(items);
}

function moduleIndexIsTypescript(moduleIndex) {
  const workspace = get(moduleIndex, "workspace", {});
  const workspaceType = get(workspace, "type", null);
  if (workspaceType === "npm-workspaces" || workspaceType === "npm-package") {
    return true;
  }
  const manifest = get(workspace, "manifest", null);
  return typeof manifest === "string" && manifest.endsWith("package.json");
}

function buildSurface(root) {
  const moduleIndex = loadModuleIndex(root);
  const isTypescript = moduleIndexIsTypescript(moduleIndex);
  const modules = [];

  for (const layer of get(moduleIndex, "layers", [])) {
    for (const module of get(layer, "modules", [])) {
      const publicItems = isTypescript || get(module, "language", null) === "typescript"
        ? extractTypescriptPublicItems(root, module)
        : extractPublicItems(root, module);
      modules.push({ name: module.name, items: publicItems });
    }
  }

  return {
    schemaVersion: 1,
    kind: "public-surface",
    generatedBy: ".ai/tools/generate-public-surface",
    visibility: isTypescript ? "project-public" : "crate-external",
    modules
  };
}

// Matches Python json.dumps(indent=2) with ensure_ascii.
function toJson(data) {
  return JSON.stringify(data, null, 2)
    .replace(/[\u007f-￿]/g, (character) => "\\u" + character.charCodeAt(0).toString(16).padStart(4, "0")) + "\n";
}

function parseArgs(argv) {
  const args = { check: false, print: false, output: ".ai/generated/public-surface.json" };
  const usageError = (message) => {
    process.stderr.write(USAGE + "\ngenerate-public-surface: error: " + message + "\n");
    process.exit(2);
  };
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "-h" || argument === "--help") {
      process.stdout.write(USAGE + "\n\nGenerate .ai/generated/public-surface.json from Rust or TypeScript source files.\n");
      process.exit(0);
    } else if (argument === "--check") {
      args.check = true;
    } else if (argument === "--print") {
      args.print = true;
    } else if (argument === "--output" || argument.startsWith("--output=")) {
      if (argument === "--output") {
        if (index + 1 >= argv.length) {
          usageError("argument --output: expected one argument");
        }
        index += 1;
        args.output = argv[index];
      } else {
        args.output = argument.slice("--output=".length);
      }
    } else {
      usageError("unrecognized arguments: " + argv.slice(index).join(" "));
    }
  }
  return args;
}

function main(argv) {
  const args = parseArgs(argv);
  const root = path.resolve(path.dirname(fs.realpathSync(__filename)), "..", "..");
  const generated = toJson(buildSurface(root));
  const outputPath = path.join(root, args.output);
  const displayPath = path.relative(root, outputPath).split(path.sep).join("/");

  if (args.check) {
    if (!isFile(outputPath)) {
      process.stderr.write("Missing generated public surface: " + displayPath + "\n");
      return 1;
    }
    if (readText(outputPath) !== generated) {
      process.stderr.write("Stale generated public surface: " + displayPath + "\n");
      return 1;
    }
    process.stdout.write("generate-public-surface check passed\n");
    return 0;
  }

  if (args.print) {
    process.stdout.write(generated);
    return 0;
  }

  fs.mkdirSync(path.dirname(outputPath), { recursive: true });
  fs.writeFileSync(outputPath, generated);
  process.stdout.write("wrote " + displayPath + "\n");
  return 0;
}

try {
  process.exitCode = main(process.argv.slice(2));
} catch (error) {
  if (!(error instanceof ToolExit)) {
    throw error;
  }
  process.stderr.write(error.message + "\n");
  process.exitCode = 1;
}
