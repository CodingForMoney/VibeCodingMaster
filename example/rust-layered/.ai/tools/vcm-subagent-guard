#!/usr/bin/env node
"use strict";
// Restrict VCM role sessions to their assigned worker subagents.

const fs = require("node:fs");

const ALLOWED_SUBAGENTS = {
  architect: [
    "vcm-architect-evidence-worker",
    "vcm-architect-scaffold-worker",
    "vcm-architect-validation-worker"
  ],
  coder: ["vcm-coder-worker"]
};

function deny(reason) {
  process.stdout.write(`${JSON.stringify({
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: reason
    }
  })}\n`);
}

function main() {
  const role = (process.env.VCM_ROLE || "").trim();
  if (!role) {
    return;
  }

  let payload;
  try {
    payload = JSON.parse(fs.readFileSync(0, "utf8"));
  } catch {
    deny("VCM could not validate this subagent request because its hook payload is invalid.");
    return;
  }

  if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
    deny("VCM could not validate this subagent request because its hook payload is invalid.");
    return;
  }

  if (payload.tool_name !== "Agent") {
    return;
  }

  if (payload.agent_id) {
    deny("VCM worker subagents may not invoke nested subagents.");
    return;
  }

  const toolInput = payload.tool_input;
  const subagentType = toolInput && typeof toolInput === "object" ? toolInput.subagent_type : undefined;
  const allowed = ALLOWED_SUBAGENTS[role];

  if (!allowed) {
    deny(`VCM role \`${role}\` may not invoke subagents.`);
    return;
  }

  if (!allowed.includes(subagentType)) {
    const requested = typeof subagentType === "string" && subagentType ? subagentType : "<missing>";
    const allowedNames = [...allowed].sort().map((name) => `\`${name}\``).join(", ");
    deny(`VCM role \`${role}\` may invoke only ${allowedNames}, not \`${requested}\`.`);
  }
}

main();
