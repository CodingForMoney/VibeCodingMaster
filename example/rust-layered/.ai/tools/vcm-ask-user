#!/usr/bin/env node
"use strict";
// Pause VCM workflow for an exact user question.

function parseToolArguments(argv, spec) {
  const prog = require("node:path").basename(process.argv[1] || "tool");
  const options = spec.options || {};
  const positionals = spec.positionals || [];
  const usage = "usage: " + prog
    + Object.keys(options).map((name) => " [" + name + (options[name].flag ? "" : " " + name.slice(2).toUpperCase()) + "]").join("")
    + positionals.map((name) => " " + name).join("");
  const fail = (message) => {
    process.stderr.write(usage + "\n" + prog + ": error: " + message + "\n");
    process.exit(2);
  };
  const values = {};
  for (const [name, option] of Object.entries(options)) {
    values[option.dest] = option.append ? [] : option.flag ? false : option.default;
  }
  const remaining = [];
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "-h" || argument === "--help") {
      process.stdout.write(usage + "\n\n" + (spec.description || "") + "\n");
      process.exit(0);
    }
    if (!argument.startsWith("--") || argument === "--") {
      remaining.push(argument);
      continue;
    }
    const separator = argument.indexOf("=");
    const name = separator >= 0 ? argument.slice(0, separator) : argument;
    const option = options[name];
    if (!option) {
      fail("unrecognized arguments: " + argument);
    }
    if (option.flag) {
      values[option.dest] = true;
      continue;
    }
    let value;
    if (separator >= 0) {
      value = argument.slice(separator + 1);
    } else {
      if (index + 1 >= argv.length) {
        fail("argument " + name + ": expected one argument");
      }
      index += 1;
      value = argv[index];
    }
    if (option.choices && !option.choices.includes(value)) {
      fail("argument " + name + ": invalid choice: '" + value + "' (choose from " + option.choices.map((choice) => "'" + choice + "'").join(", ") + ")");
    }
    if (option.append) {
      values[option.dest].push(value);
    } else {
      values[option.dest] = value;
    }
  }
  if (remaining.length > positionals.length) {
    fail("unrecognized arguments: " + remaining.slice(positionals.length).join(" "));
  }
  positionals.forEach((name, index) => {
    values[name] = remaining[index];
  });
  const missing = [
    ...positionals.filter((name) => values[name] === undefined),
    ...Object.entries(options).filter(([, option]) => option.required && values[option.dest] === undefined).map(([name]) => name)
  ];
  if (missing.length > 0) {
    fail("the following arguments are required: " + missing.join(", "));
  }
  return values;
}

async function postJson(url, body, timeoutMs) {
  const response = await fetch(url, {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify(body),
    signal: AbortSignal.timeout(timeoutMs)
  });
  return { ok: response.ok, status: response.status, statusText: response.statusText, text: await response.text() };
}

function networkErrorText(error) {
  const cause = error && error.cause;
  return (cause && (cause.message || cause.code)) || (error && error.message) || String(error);
}

function emit(status, message, state) {
  const payload = { status };
  if (message) {
    payload.message = message;
  }
  if (state !== undefined) {
    payload.state = state;
  }
  process.stdout.write(JSON.stringify(payload) + "\n");
}

async function main() {
  const args = parseToolArguments(process.argv.slice(2), {
    description: "Pause VCM workflow for an exact user question.",
    options: { "--question": { dest: "question", required: true } }
  });

  if (process.env.VCM_ROLE !== "project-manager") {
    emit("failed", "Only project-manager may ask the user through VCM workflow control.");
    return 2;
  }

  const question = args.question.trim();
  if (!question) {
    emit("failed", "A non-empty user question is required.");
    return 2;
  }

  const apiUrl = (process.env.VCM_API_URL || "").replace(/\/+$/, "");
  const taskSlug = (process.env.VCM_TASK_SLUG || "").trim();
  if (!apiUrl || !taskSlug) {
    emit("failed", "VCM_API_URL or VCM_TASK_SLUG is unavailable; the workflow was not paused.");
    return 2;
  }

  const url = apiUrl + "/api/tasks/" + encodeURIComponent(taskSlug) + "/ask-user";
  let response;
  try {
    response = await postJson(url, { question }, 5000);
  } catch (error) {
    emit("failed", "VCM could not register the user question: " + networkErrorText(error));
    return 1;
  }
  if (!response.ok) {
    emit("failed", "VCM rejected the user question: HTTP " + response.status + " " + response.text);
    return 1;
  }
  try {
    emit("awaiting_user", undefined, JSON.parse(response.text));
    return 0;
  } catch (error) {
    emit("failed", "VCM could not register the user question: " + error.message);
    return 1;
  }
}

main().then((code) => process.exit(code));
